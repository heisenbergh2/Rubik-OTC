DamageSourcePanel < UIWidget
  id: damagePanel
  size: 151 11
  cursor: pointer
  Label
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    text-auto-resize: true
    color: $var-text-cip-color
    font: $var-cip-font
  Label
    id: desc
    anchors.top: parent.top
    anchors.right: parent.right
    text-auto-resize: true
    color: $var-text-cip-color
    font: $var-cip-font

MiniWindow
  id: inputAnalyserMiniWindow
  height: 225

  &save: true
  @onSetup: |
    do
      for _, id in ipairs({ 'newWindowButton', 'toggleFilterButton' }) do
        local w = self:recursiveGetChildById(id)
        if w then
          w:setVisible(false)
          w:setOn(false)
        end
      end

      local contextMenuButton = self:recursiveGetChildById("contextMenuButton")
      if contextMenuButton then
        contextMenuButton:setMarginRight(-7)
        contextMenuButton.onMousePress = function(widget, mousePosition, mouseButton)
          if mouseButton == MouseLeftButton then
            onInputExtra(mousePosition)
            return true
          end
        end
      end
    end

  UIWidget
    id: miniwindowIcon
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /modules/game_analysers/images/icon-defensiveanalyser-widget
    image-smooth: false
  
  Label
    id: miniwindowTitle
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 1
    margin-left: 20
    font: verdana-11px-monochrome
    height: 13
    !text: tr('Input Analyser')
    color: #909090

  ScrollablePanel
    id: contentsPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: miniwindowScrollBar.left
    anchors.bottom: parent.bottom
    margin-left: 5
    margin-top: 16
    margin-right: 1
    margin-bottom: 5
    vertical-scrollbar: miniwindowScrollBar
    Label
      id: dmgTakenLabel
      !text: tr('Received Damage')
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: -2
      text-auto-resize: true
      color: $var-text-cip-color-white
      font: $var-cip-font
    Label
      id: rcvDmgLabel
      !text: tr('Total:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: rcvDmg
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font
      margin-right: 5

    Label
      id: maxDpsLabel
      !text: tr('Max-DPS:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: maxDps
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font
      margin-right: 5

    HorizontalSeparator
      id: separatorMaxDps
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      margin-left: 1
      margin-right: 2

    UIGraph
      id: graphPanel
      capacity: 240
      background-color: #383636
      color: red
      size: 133 82
      show-labels: false
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-left: 15
      margin-top: 14
      image-source: /images/game/analyzer/dpsGraphBG

    UIWidget
      id: horizontalGraph
      size: 141 9
      image-auto-resize: true
      image-source: /images/game/analyzer/graphDpsHorizontal
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 6
      margin-left: 9

    HorizontalSeparator
      id: separatorGraph
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 12
      margin-left: 1
      margin-right: 2

    Label
      id: damageTypeLabel
      !text: tr('Damage Types')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 10
      text-auto-resize: true
      color: $var-text-cip-color-white
      font: $var-cip-font

    Label
      id: noDataLabel1
      !text: tr('No data')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Panel
      id: dmgTypes
      size: 157 20
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      layout:
        type: verticalBox

    HorizontalSeparator
      id: separatorDmgType
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 0
      margin-left: 1
      margin-right: 2

    Label
      id: damageSource
      !text: tr('Damage Sources')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 10
      text-auto-resize: true
      color: $var-text-cip-color-white
      font: $var-cip-font

    Label
      id: noDataLabel2
      !text: tr('No data')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: damageSourceName
      !text: tr('Damage Types')
      anchors.top: damageSource.bottom
      anchors.left: parent.left
      margin-top: -15
      text-auto-resize: true
      color: $var-text-cip-color-white
      font: $var-cip-font
      phantom: true
      visible: false

    Panel
      id: dmgSrc
      size: 155 20
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      layout:
        type: verticalBox

    ScrollablePanel
      id: dmgSourceTypes
      size: 151 11
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      visible: true
      layout:
        type: verticalBox
        
  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder-bottom-left
    size: 14 14
    margin-left: 3
    margin-bottom: 3

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 73
    margin-left: 3
    margin-right: 3