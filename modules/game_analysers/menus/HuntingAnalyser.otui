      anchors.top: suppliesLabel.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    UIWidget
      size: 9 9
      image-auto-resize: true
      image-source: /images/icons/icon-goldcoin
      anchors.top: suppliesLabel.bottom
      anchors.right: parent.right
      margin-top: 7
      margin-right: 4

    Label
      id: balance
      !text: tr('0')
      anchors.top: suppliesLabel.bottom
      anchors.right: prev.left
      margin-top: 4
      margin-right: 4
      text-auto-resize: true
      color: $var-text-cip-color-green
      font: $var-cip-font

    Label
      id: damageLabel
      !text: tr('Damage:')
      anchors.top: balanceLabel.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: damage
      !text: tr('0')
      anchors.top: balanceLabel.bottom
      anchors.right: parent.right
      margin-top: 4
      margin-right: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: damageHourLabel
      !text: tr('Damage/h:')
      anchors.top: damageLabel.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: damageHour
      !text: tr('0')
      anchors.top: damageLabel.bottom
      anchors.right: parent.right
      margin-top: 4
      margin-right: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
