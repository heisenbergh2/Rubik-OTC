      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: healing
      !text: tr('0')
      anchors.top: damageHourLabel.bottom
      anchors.right: parent.right
      margin-top: 4
      margin-right: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: healHourLabel
      !text: tr('Healing/h:')
      anchors.top: healLabel.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: healHour
      !text: tr('0')
      anchors.top: healLabel.bottom
      anchors.right: parent.right
      margin-top: 4
      margin-right: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: killedMonstersLabel
      !text: tr('Killed Monsters:')
      anchors.top: healHourLabel.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Panel
      size: 145 15
      id: killedMonsters
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 7

      Label
        id: monster
        !text: tr('None')
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: -1
        margin-left: 1
        text-auto-resize: true
        color: $var-text-cip-color
        font: $var-cip-font

    Label
      id: lootedItemsLabel
      !text: tr('Looted Items:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 3
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Panel
      size: 145 15
      id: lootedItems
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 7

      Label
        id: loot
        !text: tr('None')
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: -1
        margin-left: 1
