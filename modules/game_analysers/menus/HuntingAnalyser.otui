MiniWindow
  id: huntingAnalyserMiniWindow
  height: 225

  &save: true
  @onSetup: |
    do
      for _, id in ipairs({ 'newWindowButton', 'toggleFilterButton' }) do
        local w = self:recursiveGetChildById(id)
        if w then
          w:setVisible(false)
          w:setOn(false)
        end
      end

      local contextMenuButton = self:recursiveGetChildById("contextMenuButton")
      if contextMenuButton then
        contextMenuButton:setMarginRight(-7)
        contextMenuButton.onMousePress = function(widget, mousePosition, mouseButton)
          if mouseButton == MouseLeftButton then
            onHuntingExtra(mousePosition)
            return true
          end
        end
      end
    end

  UIWidget
    id: miniwindowIcon
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /modules/game_analysers/images/icon-huntingsessionanalyser-widget
    image-smooth: false
  
  Label
    id: miniwindowTitle
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 1
    margin-left: 20
    font: verdana-11px-monochrome
    height: 13
    !text: tr('Hunt Analyser')
    color: #909090

  ScrollablePanel
    id: contentsPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: miniwindowScrollBar.left
    anchors.bottom: parent.bottom
    margin-left: 5
    margin-top: 16
    margin-right: 1
    margin-bottom: 5
    vertical-scrollbar: miniwindowScrollBar
    
    Label
      id: sessionLabel
      !text: tr('Session:')
      anchors.top: parent.top
      anchors.left: parent.left
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: session
      !text: tr('00:00h')
      anchors.top: parent.top
      anchors.right: parent.right
      margin-right: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: rawXpLabel
      !text: tr('Raw XP Gain:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font
      visible: false

    Label
      id: rawXpGain
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      margin-right: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font
      visible: false

    Label
      id: xpLabel
      !text: tr('XP Gain:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: xpGain
      !text: tr('0')
      anchors.top: rawXpGain.bottom
      anchors.right: parent.right
      margin-top: 4
      margin-right: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: rawXpHourLabel
      !text: tr('Raw XP/h:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font
      visible: false

    Label
      id: rawXpHour
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      margin-right: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font
      visible: false

    Label
      id: xpHourLabel
      !text: tr('XP/h:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: xpHour
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      margin-top: 4
      margin-right: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: lootLabel
      !text: tr('Loot:')
      anchors.top: xpHourLabel.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    UIWidget
      size: 9 9
      image-auto-resize: true
      image-source: /images/icons/icon-goldcoin
      anchors.top: xpHourLabel.bottom
      anchors.right: parent.right
      margin-top: 7
      margin-right: 4

    Label
      id: loot
      !text: tr('0')
      anchors.top: xpHourLabel.bottom
      anchors.right: prev.left
      margin-top: 4
      margin-right: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: suppliesLabel
      !text: tr('Supplies:')
      anchors.top: lootLabel.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    UIWidget
      size: 9 9
      image-auto-resize: true
      image-source: /images/icons/icon-goldcoin
      anchors.top: lootLabel.bottom
      anchors.right: parent.right
      margin-top: 7
      margin-right: 4

    Label
      id: supplies
      !text: tr('0')
      anchors.top: lootLabel.bottom
      anchors.right: prev.left
      margin-top: 4
      margin-right: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: balanceLabel
