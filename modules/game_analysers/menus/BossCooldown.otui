BossInfo < UIWidget
  id: bossInfoPanel
  size: 147 36
  margin: 2 0 0 4
  $!first:
    margin-top: -4

  UICreature
    id: creature
    anchors.top: parent.top
    anchors.left: parent.left
    visible: true
    size: 32 32
    phantom: true
    margin-top: -5
    margin-left: 1

  Label
    id: bossName
    anchors.top: parent.top
    anchors.left: creature.right
    margin-top: -3
    margin-left: 7
    !text: tr('Boss')
    font: $var-cip-font
    color: $var-text-cip-color-highlight
    text-auto-resize: true
    phantom: true

  Label
    id: bossNCooldown
    anchors.top: prev.bottom
    anchors.left: creature.right
    margin-top: 1
    margin-left: 7
    !text: tr('No Cooldown')
    font: $var-cip-font
    color: $var-text-cip-color
    text-auto-resize: true
    phantom: true

MiniWindow
  id: bossCdAnalyserMiniWindow
  height: 225
  &save: true
  @onSetup: |
    do
      for _, id in ipairs({ 'newWindowButton', 'toggleFilterButton', 'contextMenuButton' }) do
        local w = self:recursiveGetChildById(id)
        if w then
          w:setVisible(false)
          w:setOn(false)
        end
      end
    end

  UIWidget
    id: miniwindowIcon
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /modules/game_analysers/images/icon-bosstracker-widget
    image-smooth: false
  
  Label
    id: miniwindowTitle
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 1
    margin-left: 20
    font: verdana-11px-monochrome
    height: 13
    !text: tr('Boss Cooldowns')
    color: #909090
  focusable: true

  ScrollablePanel
    id: contentsPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: miniwindowScrollBar.left
    anchors.bottom: parent.bottom
    margin-top: 15
    margin-left: 4
    margin-right: 1
    margin-bottom: 5
    step: 20
    vertical-scrollbar: miniwindowScrollBar

    TextEdit
      id: searchText
      size: 147 20
      focusable: true
      anchors.top: parent.top
      anchors.left: parent.left
      padding-top: 2
      margin-left: 4
      margin-top: 2
      box-text-padding: 27
      placeholder-color: $var-cip-inactive-color
      @onTextChange: modules.game_analysers.checkBossSearch(self:getText())
      !placeholder: tr('Type to search')

      Button
        id: clearSearchButton
        anchors.top: parent.top
        anchors.right: parent.right
        margin-top: -1
        margin-right: 1
        size: 18 18
        image-source: /images/ui/button-erase-18x18-up
        image-clip: 0 0 18 18
        $hover !pressed:
          image-source: /images/ui/button-erase-18x18-up
          image-clip: 0 0 18 18
        $pressed:
          image-source: /images/ui/button-erase-18x18-down
          image-clip: 0 0 18 18
        @onClick: modules.game_analysers.clearSearch()

    Panel
      id: bosses
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      layout:
        type: verticalBox

  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder-bottom-left
    size: 14 14
    margin-left: 3
    margin-bottom: 3

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 64
    margin-left: 3
    margin-right: 3