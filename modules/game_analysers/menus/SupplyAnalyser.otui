SupplyAnalyserItem < UIItem
  size: 32 32
  virtual: true
  show-count: true
  always-show-count: true
  virtual-count: true
  font: verdana-11px-rounded
  tooltip-delayed: true

MiniWindow
  id: supplyAnalyserMiniWindow
  height: 225
  &save: true
  @onSetup: |
    do
      for _, id in ipairs({ 'newWindowButton', 'toggleFilterButton' }) do
        local w = self:recursiveGetChildById(id)
        if w then
          w:setVisible(false)
          w:setOn(false)
        end
      end

      local contextMenuButton = self:recursiveGetChildById("contextMenuButton")
      if contextMenuButton then
        contextMenuButton:setMarginRight(-7)
        contextMenuButton.onMousePress = function(widget, mousePosition, mouseButton)
          if mouseButton == MouseLeftButton then
            onSupplyExtra(mousePosition, "false")
            return true
          end
        end
      end
    end

  UIWidget
    id: miniwindowIcon
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /modules/game_analysers/images/icon-wasteanalyser-widget
    image-smooth: false
  
  Label
    id: miniwindowTitle
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 1
    margin-left: 20
    font: verdana-11px-monochrome
    height: 13
    !text: tr('Supply Analyser')
    color: #909090

  ScrollablePanel
    id: contentsPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: miniwindowScrollBar.left
    anchors.bottom: parent.bottom
    margin-left: 5
    margin-top: 16
    margin-right: 1
    margin-bottom: 5
    vertical-scrollbar: miniwindowScrollBar
    Label
      id: goldLabel
      !text: tr('Gold Value:')
      anchors.top: parent.top
      anchors.left: parent.left
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    UIWidget
      size: 9 9
      image-auto-resize: true
      image-source: /images/icons/icon-goldcoin
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 3
      margin-right: 4

    Label
      id: gold
      !text: tr('0')
      anchors.top: parent.top
      anchors.right: prev.left
      margin-right: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: perHourLabel
      !text: tr('Per Hour:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    UIWidget
      size: 9 9
      image-auto-resize: true
      image-source: /images/icons/icon-goldcoin
      anchors.top: prev.top
      anchors.right: parent.right
      margin-top: 3
      margin-right: 4

    Label
      id: goldHour
      !text: tr('0')
      anchors.top: perHourLabel.top
      anchors.right: prev.left
      margin-right: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    HorizontalSeparator
      id: separator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 1
      margin-right: 2

    Panel
      id: lootedItems
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      visible: false
      layout:
        type: grid
        cell-size: 32 32
        cell-spacing: 3
        num-columns: 4

    HorizontalSeparator
      id: separatorLootedItems
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      visible: false
      margin-left: 1
      margin-right: 2

    Label
      id: targetLabel
      !text: tr('Target:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    UIWidget
      id: goldLabelIcon
      size: 9 9
      image-auto-resize: true
      image-source: /images/icons/icon-goldcoin
      anchors.top: prev.top
      anchors.right: parent.right
      margin-top: 3
      margin-right: 4

    Label
      id: goldTarget
      !text: tr('0')
      anchors.top: targetLabel.top
      anchors.right: prev.left
      margin-right: 4
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    UIWidget
      id: supplyTargetBG
      size: 152 11
      image-auto-resize: true
      image-source: /images/game/analyzer/invertTargetBG
      anchors.top: prev.bottom
      anchors.right: parent.right
      margin-top: 6
      margin-right: 4

      UIWidget
        id: supplyArrow
        size: 9 8
        image-auto-resize: true
        image-source: /images/game/analyzer/arrow
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        margin-bottom: -1
        margin-left: 71

    HorizontalSeparator
      id: separatorGauge
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 7
      margin-left: 1
      margin-right: 2

    UIGraph
      id: graphPanel
      capacity: 60
      background-color: #383636
      color: red
      size: 129 83
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-left: 15
      margin-top: 9
      show-labels: false
      image-source: /images/game/analyzer/supplyGraphBG

    UIWidget
      id: graphHorizontal
      size: 140 9
      image-auto-resize: true
      image-source: /images/game/analyzer/graphHorizontal
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-left: 6
      margin-top: 5

  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder-bottom-left
    size: 14 14
    margin-left: 3
    margin-bottom: 3

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 64
    margin-left: 3
    margin-right: 3
