MiniWindow
  id: xpAnalyserMiniWindow
  height: 218

  &save: true
  @onSetup: |
    do
      for _, id in ipairs({ 'newWindowButton', 'toggleFilterButton' }) do
        local w = self:recursiveGetChildById(id)
        if w then
          w:setVisible(false)
          w:setOn(false)
        end
      end

      local contextMenuButton = self:recursiveGetChildById("contextMenuButton")
      if contextMenuButton then
        contextMenuButton:setMarginRight(-7)
        contextMenuButton.onMousePress = function(widget, mousePosition, mouseButton)
          if mouseButton == MouseLeftButton then
            onXPExtra(mousePosition, "false")
            return true
          end
        end
      end
    end

  UIWidget
    id: miniwindowIcon
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /modules/game_analysers/images/icon-progressanalyser-widget
    image-smooth: false
  
  Label
    id: miniwindowTitle
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 1
    margin-left: 20
    font: verdana-11px-monochrome
    height: 13
    !text: tr('XP Analyser')
    color: #909090

  ScrollablePanel
    id: contentsPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: miniwindowScrollBar.left
    anchors.bottom: parent.bottom
    margin-left: 5
    margin-top: 16
    margin-right: 1
    margin-bottom: 5
    vertical-scrollbar: miniwindowScrollBar
    UIWidget
      id: topParent
      size: 1 1
      anchors.top: parent.top
      anchors.left: parent.left

    Label
      id: rawXpLabel
      !text: tr('Raw XP Gain:')
      anchors.top: topParent.bottom
      anchors.left: parent.left
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font
      visible: false
      margin-top: -2
      margin-left: 2

    Label
      id: rawXpGain
      !text: tr('0')
      anchors.top: topParent.top
      anchors.right: parent.right
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font
      margin-top: -2
      margin-right: 5

    Label
      id: xpLabel
      !text: tr('XP Gain:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-left: 2
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: xpGain
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font
      margin-right: 5

    Label
      id: rawXpHourLabel
      !text: tr('Raw XP/h:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 4
      margin-left: 2
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font
      visible: false

    Label
      id: rawXpHour
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font
      margin-right: 5

    Label
      id: xpHourLabel
      !text: tr('XP/h:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 4
      margin-left: 2
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: xpHour
      !text: tr('0')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font
      margin-right: 5

    Label
      id: nextLevelLabel
      !text: tr('Next Level:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 4
      margin-left: 2
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font

    Label
      id: nextLevel
      !text: tr('-')
      anchors.top: prev.top
      anchors.right: parent.right
      text-auto-resize: true
      color: $var-text-cip-color
      font: $var-cip-font
      margin-right: 5

    ProgressBar
      id: percent
      background-color: #008000
      height: 5
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 5
      margin-left: 3
      margin-right: 7
      phantom: false

    HorizontalSeparator
      id: separatorPercent
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      margin-left: 3
      margin-right: 4

    UIWidget
      id: xpBG
      size: 152 11
      image-auto-resize: true
      image-source: /images/game/analyzer/targetBG
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 7
      margin-left: 3
      margin-right: 7

      UIWidget
        id: xpArrow
        size: 9 8
        image-auto-resize: true
        image-source: /images/game/analyzer/arrow
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        margin-bottom: -1
        margin-left: 1

    HorizontalSeparator
      id: separatorGauge
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 7
      margin-left: 3
      margin-right: 4

    UIGraph
      id: graphPanel
      capacity: 60
      background-color: #383636
      color: red
      size: 129 83
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 9
      margin-left: 17
      show-labels: false
      image-source: /images/game/analyzer/xpGraphBG

    UIWidget
      id: graphHorizontal
      size: 140 9
      image-auto-resize: true
      image-source: /images/game/analyzer/graphHorizontal
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-left: 8
      margin-top: 5

  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder-bottom-left
    size: 14 14
    margin-left: 3
    margin-bottom: 3

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 79
    maximum: 218
    margin-left: 3
    margin-right: 3
