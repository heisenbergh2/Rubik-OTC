EquipmentAssignActionSlot < UIWidget
  size: 34 34
  image-source: /images/game/actionbar/slot-actionbar-filled
  image-size: 34 34
  image-clip: 0 0 34 34
  phantom: false

  UIWidget
    id: equipmentSlotIcon
    anchors.centerIn: parent
    size: 32 32
    image-source: /images/game/spells/equipment-icons
    image-size: 32 32
    image-clip: 0 0 32 32
    phantom: true

  UIWidget
    id: equipmentTypeIcon
    size: 9 9
    image-size: 9 9
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-left: 1
    margin-bottom: 1
    phantom: true
    visible: false

EquipmentAssignCopySetButton < UIButton
  size: 34 34
  phantom: false
  image-source: /images/game/actionbar/slot-actionbar-filled
  image-size: 34 34
  image-clip: 0 0 34 34
  icon-source: /images/game/actionbar/icon-copy-set
  icon-offset: 1 1
  icon-size: 32 32

  $pressed:
    image-clip: 0 34 34 34
    icon-offset: 2 2

  $disabled:
    image-clip: 0 34 34 34
    opacity: 0.8

MainLogoWindow
  !text: ''
  size: 240 400
  padding-top: 8
  padding-left: 8
  padding-right: 8
  padding-bottom: 8
  clipping: false
  margin-top: -1
  @onEscape: modules.game_actionbar.closeEquipmentAssignWindow()
  @onEnter: modules.game_actionbar.equipmentAssignOk()

  Panel
    id: equipmentPanel
    size: 210 320
    clipping: false
    phantom: false
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: logoBackdropCrest.bottom
    margin-top: 2
    margin-left: 1

    EquipmentAssignNeckSlot
      id: neckSlot
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 36
      &inventorySlot: 2

    EquipmentAssignHeadSlot
      id: headSlot
      anchors.top: parent.top
      anchors.left: neckSlot.right
      margin-left: 6
      &inventorySlot: 1

    EquipmentAssignBackSlot
      id: backSlot
      anchors.top: parent.top
      anchors.left: headSlot.right
      margin-top: 36
      margin-left: 6
      &inventorySlot: 3

    EquipmentAssignLeftSlot
      id: leftSlot
      anchors.top: neckSlot.bottom
      anchors.left: neckSlot.left
      margin-top: 6
      &inventorySlot: 6

    EquipmentAssignRingSlot
      id: ringSlot
      anchors.top: leftSlot.bottom
      anchors.left: neckSlot.left
      margin-top: 6
      &inventorySlot: 9

    EquipmentAssignBodySlot
      id: bodySlot
      anchors.top: headSlot.bottom
      anchors.left: headSlot.left
      margin-top: 6
      &inventorySlot: 4

    EquipmentAssignLegSlot
      id: legSlot
      anchors.top: bodySlot.bottom
      anchors.left: headSlot.left
      margin-top: 6
      &inventorySlot: 7

    EquipmentAssignFeetSlot
      id: feetSlot
      anchors.top: legSlot.bottom
      anchors.left: headSlot.left
      margin-top: 6
      &inventorySlot: 8

    EquipmentAssignRightSlot
      id: rightSlot
      anchors.top: backSlot.bottom
      anchors.left: backSlot.left
      margin-top: 6
      &inventorySlot: 5

    EquipmentAssignAmmoSlot
      id: ammoSlot
      anchors.top: rightSlot.bottom
      anchors.left: backSlot.left
      margin-top: 6
      &inventorySlot: 10

    EquipmentAssignCopySetButton
      id: copySetButton
      anchors.top: feetSlot.bottom
      anchors.left: feetSlot.left
      margin-top: 6
      margin-left: -3
      !tooltip: tr('Copy your equipped equipments')
      @onClick: modules.game_actionbar.equipmentAssignCopyCurrentSet()

    EquipmentAssignActionSlot
      id: assignActionSlot
      anchors.top: copySetButton.top
      anchors.left: copySetButton.right
      margin-left: 5
      !tooltip: tr('Assign an icon to this equipment slot')
      @onClick: modules.game_actionbar.openEquipmentAssignIconWindow()

  HorizontalSeparator
    id: equipmentSeparator
    anchors.top: equipmentPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 2

  Button
    id: okButton
    text: Ok
    size: 43 20
    margin-right: 6
    text-offset: 0 0
    anchors.bottom: cancelButton.bottom
    anchors.right: applyButton.left
    enabled: false
    @onClick: modules.game_actionbar.equipmentAssignOk()

  Button
    id: applyButton
    text: Apply
    size: 43 20
    anchors.bottom: cancelButton.bottom
    anchors.right: cancelButton.left
    margin-right: 6
    text-offset: 0 0
    enabled: false
    @onClick: modules.game_actionbar.equipmentAssignApply()

  Button
    id: cancelButton
    text: Cancel
    size: 43 20
    text-offset: 0 0
    margin-right: 8
    margin-bottom: 8
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    @onClick: modules.game_actionbar.closeEquipmentAssignWindow()
