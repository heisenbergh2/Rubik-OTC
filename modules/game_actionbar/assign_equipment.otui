EquipmentAssignSlot < UIWidget
  size: 66 66
  image-source: /images/ui/item66
  phantom: false

EquipmentAssignItem < Item
  anchors.centerIn: parent
  size: 64 64
  fixed-item-size: false
  padding: 0
  image-source:
  virtual: true
  phantom: true
  focusable: false
  show-count: false

  UIWidget
    id: tier
    visible: false

  UIWidget
    id: bigtier
    size: 19 16
    image-source: /images/inventory/tiers-strip-big
    image-clip: 0 0 10 9
    image-size: 18 16
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: -1
    phantom: true
    focusable: false
    visible: false
    image-smooth: true

  UIWidget
    id: quickloot
    visible: false
    phantom: true
    focusable: false

EquipmentAssignNeckSlot < EquipmentAssignSlot
  UIWidget
    id: slotIcon
    anchors.centerIn: parent
    size: 64 64
    image-source: /images/inventory/inventory_neck
    phantom: true

  EquipmentAssignItem
    id: equippedItem

