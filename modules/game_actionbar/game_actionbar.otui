ActionBarCooldownProgress < UIProgressRect
  background: #000000B4
  percent: 100
  focusable: false
  size: 32 32
  phantom: true
  font: Verdana Bold-11px-outline
  color: #dfdfdf

ActionSlot < UIActionSlot
  size: 34 34
  image-source: /images/game/actionbar/slot-actionbar-empty
  anchors.left: prev.right
  anchors.top: parent.top
  margin-left: 3
  image-size: 34 34
  font: Verdana-8px-outline
  color: #ffffff
  border-color: #ffffff
  show-count: false
  always-show-count: false
  visible: false
  $pressed:
    opacity: 1.0
  $!pressed:
    opacity: 1.0

  Label
    id: count
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 0
    margin-right: 1
    phantom: true
    text-auto-resize: true
    font: Verdana-8px-outline
    color: #ffffff
    visible: false

  UIWidget
    id: tier
    size: 9 8
    image-source: /images/inventory/tiers-strip
    image-clip: 0 0 9 8
    image-size: 9 8
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: 1
    margin-top: 1
    phantom: true
    focusable: false
    visible: false
    image-smooth: true

  UIWidget
    id: spellIcon
    size: 32 32
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    image-size: 32 32
    visible: false
    phantom: true
    focusable: false

  Panel
    id: gray
    size: 32 32
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    image-source: /assets/images/game/actionbar/slot-disabled
    image-size: 32 32
    visible: false

  Label
    id: key
    anchors.top: parent.top
    anchors.right: parent.right
    text-auto-resize: true
    margin-right: 1
    font: Verdana-8px-outline
    color: #ffffff

  Label
    id: text
    anchors.fill: parent
    text-auto-resize: true
    text-wrap: true
    text-align: center
    margin-left: -1
    font: Verdana-8px-outline
    color: #ffffff

  Label
    id: spellParameter
    width: 34
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 0
    margin-right: 0
    phantom: true
    text-auto-resize: false
    text-align: right
    font: Verdana-8px-outline
    color: #ffffff
    visible: false

  UIWidget
    id: multiIcon
    size: 5 11
    image-source: /assets/images/game/actionbar/marker-multiactionbutton
    image-size: 5 11
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 1
    margin-top: 1
    phantom: true
    focusable: false
    visible: false

  UIWidget
    id: equipmentTypeIcon
    size: 9 9
    image-size: 9 9
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-left: 1
    margin-bottom: 1
    phantom: true
    focusable: false
    visible: false

  UIWidget
    id: activeSpell
    size: 32 32
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    image-source: /assets/images/game/actionbar/border_activespell
    image-size: 32 32
    visible: false
    phantom: true
    focusable: false

// Raiz da barra inferior: filhos rolados ficam em actionBarContent; lock no canto NE da janela (acompanha layout / splitter).
UIWindow
  visible: true
  height: 42
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  padding-top: 2
  text-align: center
  //background-color: gray
  auto-focus: first
  draggable: false
  phantom: false
  focusable: false

  Panel
    id: actionBarContent
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-right: 12

    UIButton
      id: prevButton
      image-source: /images/game/actionbar/button-prev-left
      image-clip: 0 0 17 17
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 1
      size: 17 17
      @onClick: |
        modules.game_actionbar.onDecrementHorizontalScroll(self:getParent():getParent(), 36)

      $pressed:
        image-clip: 0 17 17 17

      $disabled:
        image-clip: 0 34 17 17

    UIButton
      id: prevSkipButton
      image-source: /images/game/actionbar/button-skip-left
      image-clip: 0 0 17 17
      anchors.left: parent.left
      anchors.top: prevButton.bottom
      margin-top: 1

      size: 17 17
      @onClick: |
        modules.game_actionbar.onDecrementHorizontalScroll(self:getParent():getParent(), 999)

      $pressed:
        image-clip: 0 17 17 17

      $disabled:
        image-clip: 0 34 17 17

    ScrollablePanel
      id: actionBarPanel
      anchors.top: parent.top
      anchors.left: prevButton.right
      anchors.right: nextButton.left
      anchors.bottom: parent.bottom
      horizontal-scrollbar: horizontalScroll
      inverted-scroll: false
      margin-left: 1
      margin-right: 4
      margin-top: 1
      height: 40

    HorizontalScrollBar
      id: horizontalScroll
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 38
      pixels-scroll: true
      visible: false

    UIButton
      id: nextButton
      image-source: /images/game/actionbar/button-prev-right
      image-clip: 0 0 17 17
      anchors.right: parent.right
      anchors.top: parent.top
      margin-top: 1
      size: 17 17
      @onClick: |
        modules.game_actionbar.onIncrementHorizontalScroll(self:getParent():getParent(), 36)

      $pressed:
        image-clip: 0 17 17 17

      $disabled:
        image-clip: 0 34 17 17

    UIButton
      id: nextSkipButton
      image-source: /images/game/actionbar/button-skip-right
      image-clip: 0 0 17 17
      anchors.right: parent.right
      anchors.top: nextButton.bottom
      size: 17 17
      margin-top: 1
      @onClick: |
        modules.game_actionbar.onIncrementHorizontalScroll(self:getParent():getParent(), 999)

      $pressed:
        image-clip: 0 17 17 17

      $disabled:
        image-clip: 0 34 17 17

  UIButton
    id: bottomLockButton
    width: 12
    height: 34
    focusable: false
    phantom: false
    visible: false
    text-offset: 0 0
    image-offset: 0 0
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 3
    @onClick: |
      modules.game_actionbar.setLocked(not modules.game_actionbar.getLocked())
