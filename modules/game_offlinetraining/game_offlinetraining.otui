OfflineTrainingWindow < MainWindowHigh
  id: offlineTraining
  !text: tr('Offline Training')
  size: 240 318
  text-offset: 0 1
  anchors.centerIn: parent
  @onEscape: modules.game_offlinetraining.cancel()

  Label
    !text: tr('While logged out, you can train')
    font: $var-cip-font
    text-auto-resize: true
    color: #c0c0c0
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: -8
    margin-left: 1
    text-wrap: true

  Label
    !text: tr('one of these skills using offline')
    font: $var-cip-font
    text-auto-resize: true
    color: #c0c0c0
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    margin-left: 1
    text-wrap: true

  Label
    !text: tr('training. Shielding is always')
    font: $var-cip-font
    text-auto-resize: true
    color: #c0c0c0
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: -1
    margin-left: 11
    text-wrap: true

  Label
    !text: tr('trained alongside.')
    font: $var-cip-font
    text-auto-resize: true
    color: #c0c0c0
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: -1
    margin-left: 44
    text-wrap: true

  SkillButton
    id: magiclevel
    height: 21
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 55
    margin-left: -1
    margin-right: 48
    SkillNameLabel
      !text: tr('Magic')
    SkillValueLabel
    ImageSkill
      image-source: /images/game/creatures/icons-skills
      image-clip: 27 0 9 9
      image-size: 9 9
      margin-left: 1
    SkillPercentPanel
      background-color: #00c000

  SkillButton
    id: skillId0
    height: 21
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 9
    margin-left: -1
    margin-right: 48
    SkillNameLabel
      !text: tr('Fist')
    SkillValueLabel
    ImageSkill
      image-source: /images/game/creatures/icons-skills
      image-clip: 0 0 9 9
      image-size: 9 9
      margin-left: 1
    SkillPercentPanel

  SkillButton
    id: skillId1
    height: 21
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 9
    margin-left: -1
    margin-right: 48
    SkillNameLabel
      !text: tr('Club')
    SkillValueLabel
    ImageSkill
      image-source: /images/game/creatures/icons-skills
      image-clip: 45 0 9 9
      image-size: 9 9
      margin-left: 1
    SkillPercentPanel

  SkillButton
    id: skillId2
    height: 21
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 9
    margin-left: -1
    margin-right: 48
    SkillNameLabel
      !text: tr('Sword')
    SkillValueLabel
    ImageSkill
      image-source: /images/game/creatures/icons-skills
      image-clip: 36 0 9 9
      image-size: 9 9
      margin-left: 1
    SkillPercentPanel

  SkillButton
    id: skillId3
    height: 21
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 9
    margin-left: -1
    margin-right: 48
    SkillNameLabel
      !text: tr('Axe')
    SkillValueLabel
    ImageSkill
      image-source: /images/game/creatures/icons-skills
      image-clip: 54 0 9 9
      image-size: 9 9
      margin-left: 1
    SkillPercentPanel

  SkillButton
    id: skillId4
    height: 21
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 9
    margin-left: -1
    margin-right: 48
    SkillNameLabel
      !text: tr('Distance')
    SkillValueLabel
    ImageSkill
      image-source: /images/game/creatures/icons-skills
      image-clip: 18 0 9 9
      image-size: 9 9
      margin-left: 1
    SkillPercentPanel

// case 5: SKILL_MAGLEVEL
  Button
    !text: tr('Train')
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 57
    height: 20
    width: 43
    @onClick: modules.game_offlinetraining.sendOfflineTraining(5)

// case 6: SKILL_FIST
  Button
    !text: tr('Train')
    anchors.top: prev.bottom
    anchors.right: parent.right
    margin-top: 10
    height: 20
    width: 43
    @onClick: modules.game_offlinetraining.sendOfflineTraining(6)

// case 3: SKILL_CLUB
  Button
    !text: tr('Train')
    anchors.top: prev.bottom
    anchors.right: parent.right
    margin-top: 10
    height: 20
    width: 43
    @onClick: modules.game_offlinetraining.sendOfflineTraining(3)

// case 1: SKILL_SWORD
  Button
    !text: tr('Train')
    anchors.top: prev.bottom
    anchors.right: parent.right
    margin-top: 10
    height: 20
    width: 43
    @onClick: modules.game_offlinetraining.sendOfflineTraining(1)

// case 2: SKILL_AXE
  Button
    !text: tr('Train')
    anchors.top: prev.bottom
    anchors.right: parent.right
    margin-top: 10
    height: 20
    width: 43
    @onClick: modules.game_offlinetraining.sendOfflineTraining(2)

// case 4: SKILL_DISTANCE
  Button
    !text: tr('Train')
    anchors.top: prev.bottom
    anchors.right: parent.right
    margin-top: 10
    height: 20
    width: 43
    @onClick: modules.game_offlinetraining.sendOfflineTraining(4)

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 30

  Button
    id: closeButton
    !text: tr('Cancel')
    anchors.top: prev.bottom
    anchors.right: parent.right
    margin-top: 11
    height: 20
    width: 43
    @onClick: modules.game_offlinetraining.cancel()
