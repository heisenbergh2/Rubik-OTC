WorldTransferReqRow < UIWidget
  height: 16
  focusable: false
  margin-top: 2
  margin-left: 2

  UIWidget
    id: reqIcon
    size: 12 12
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    image-fixed-ratio: true
    focusable: false
    phantom: true

  Label
    id: reqText
    anchors.left: reqIcon.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    font: $var-cip-font-new
    color: #c0c0c0
    text-align: left
    focusable: false
    phantom: true

StoreWindow
  id: worldTransferWindow
  size: 450 356
  padding: 3
  visible: false
  font: $var-cip-font-new
  color: #909090
  text-offset: 0 2

  Panel
    id: step1Panel
    anchors.fill: parent
    background-color: alpha

    Label
      id: characterLabel1
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 26
      margin-left: 12
      font: $var-cip-font-new
      color: #e0e0e0
      text-align: left
      text-auto-resize: true

    Label
      id: requirementsIntroText
      anchors.top: characterLabel1.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 11
      margin-left: 12
      margin-right: 8
      font: $var-cip-font-new
      color: #c0c0c0
      !text: tr('The following conditions must be met before you can purchase a Character World Transfer.')
      text-wrap: true
      text-auto-resize: true
      text-align: left

    Panel
      id: requirementsList
      anchors.top: requirementsIntroText.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      margin-left: 8
      margin-right: 8
      height: 0
      layout: verticalBox
      background-color: alpha
      padding: 2

    Label
      id: fulfillText
      anchors.top: requirementsList.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 12
      margin-left: 12
      margin-right: 8
      font: $var-cip-font-new
      color: #c0c0c0
      text-wrap: true
      text-auto-resize: true
      text-align: left

    Label
      id: targetWorldLabel
      anchors.top: fulfillText.bottom
      anchors.left: parent.left
      margin-top: 20
      margin-left: 12
      font: $var-cip-font-new
      color: #c0c0c0
      !text: tr('Target world:')
      text-auto-resize: true

    QtComboBox
      id: worldCombo
      anchors.left: targetWorldLabel.right
      anchors.verticalCenter: targetWorldLabel.verticalCenter
      margin-top: -1
      margin-left: 3
      width: 309
      height: 20
      font: $var-cip-font-new
      color: #c0c0c0

    UIWidget
      id: infoIcon
      anchors.left: worldCombo.right
      anchors.verticalCenter: worldCombo.verticalCenter
      margin-left: 6
      size: 12 12
      image-source: /images/icons/show_gui_help_grey
      focusable: false

    HorizontalSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: btnCancel1.bottom
      margin-left: 13
      margin-right: 13
      margin-bottom: 35

    CipsoftButton
      id: btnCancel1
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-right: 13
      margin-bottom: 13
      !text: tr('Cancel')
      size: 64 20
      text-offset: 0 1
      color: #ffffff

    CipsoftButton
      id: btnNext
      anchors.right: btnCancel1.left
      anchors.bottom: btnCancel1.bottom
      margin-right: 11
      !text: tr('Next')
      size: 64 20
      text-offset: 0 1
      color: #ffffff
      enabled: false

      $disabled:
        color: #c0c0c0
        opacity: 0.8
        change-cursor-image: false

      $hover !disabled:
        color: #ffffff

  Panel
    id: step2Panel
    anchors.fill: parent
    background-color: alpha
    visible: false

    Label
      id: characterLabel2
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 26
      margin-left: 12
      font: $var-cip-font-new
      color: #e0e0e0
      text-align: left
      text-auto-resize: true

    Label
      id: targetWorldConfirm
      anchors.top: characterLabel2.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 11
      margin-left: 12
      font: $var-cip-font-new
      color: #e0e0e0
      text-align: left
      text-auto-resize: true

    Label
      anchors.top: targetWorldConfirm.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 11
      margin-left: 12
      margin-right: 12
      font: $var-cip-font-new
      color: #c0c0c0
      !text: tr('Please read the following notes before purchasing the Character World Transfer:')
      text-wrap: true
      text-auto-resize: true
      id: notesIntroText

    QtCheckBox
      id: acceptCheckbox
      anchors.left: parent.left
      anchors.bottom: btnCancel2.top
      margin-left: 12
      margin-bottom: 19
      height: 18
      width: 260
      font: $var-cip-font-new
      color: #c0c0c0
      !text: tr('I understand and wish to proceed')
      text-offset: 16 -1

    UIScrollArea
      id: notesList
      anchors.top: notesIntroText.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: acceptCheckbox.top
      margin-top: 6
      margin-left: 6
      margin-right: 6
      margin-bottom: 6
      padding: 2
      padding-right: 14
      auto-focus: none
      vertical-scrollbar: notesScrollbar
      layout:
        type: verticalBox
        spacing: 0

      Label
        margin-top: 4
        margin-left: 4
        margin-right: 4
        font: $var-cip-font-new
        color: #c0c0c0
        text-wrap: true
        text-auto-resize: true
        !text: tr('\149 If you are a member of a guild, you will be removed from the guild once your character has been transferred. Make sure to pick up all your items from the guild hall or they will remain with the guild.')
        focusable: false

      Label
        margin-top: 4
        margin-left: 4
        margin-right: 4
        font: $var-cip-font-new
        color: #c0c0c0
        text-wrap: true
        text-auto-resize: true
        !text: tr('\149 In case you are married, you will be divorced as soon as your character has been transferred.')
        focusable: false

      Label
        margin-top: 4
        margin-left: 4
        margin-right: 4
        font: $var-cip-font-new
        color: #c0c0c0
        text-wrap: true
        text-auto-resize: true
        !text: tr('\149 A pending bid on a house or a pending house transfer will be cancelled.')
        focusable: false

      Label
        margin-top: 4
        margin-left: 4
        margin-right: 4
        font: $var-cip-font-new
        color: #c0c0c0
        text-wrap: true
        text-auto-resize: true
        !text: tr('\149 All of your open Market offers will be cancelled. The items will be sent to your Inbox.')
        focusable: false

      Label
        margin-top: 4
        margin-left: 4
        margin-right: 4
        font: $var-cip-font-new
        color: #c0c0c0
        text-wrap: true
        text-auto-resize: true
        !text: tr('\149 Make sure to select a game world located near your own home. Otherwise you might experience connection problems.')
        focusable: false

      Label
        margin-top: 4
        margin-left: 4
        margin-right: 4
        font: $var-cip-font-new
        color: #f0a030
        text-wrap: true
        text-auto-resize: true
        !text: tr('\149 If you are ready for the transfer, sail to Travora and ask NPC Sharon to teleport you to the transfer platform. If you log out there, the Character World Transfer will be initiated at the next server save.')
        focusable: false

    HorizontalSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: btnCancel2.bottom
      margin-left: 13
      margin-right: 13
      margin-bottom: 30

    CipsoftButton
      id: btnCancel2
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-right: 13
      margin-bottom: 13
      !text: tr('Cancel')
      size: 64 20
      text-offset: 0 1
      color: #ffffff

    CipsoftButton
      id: btnBuyNow
      anchors.right: btnCancel2.left
      anchors.bottom: btnCancel2.bottom
      margin-right: 11
      !text: tr('Buy Now')
      size: 64 20
      text-offset: 0 1
      color: #ffffff
      image-source: /images/ui/button-blue-up
      image-border: 2
      enabled: false

      $hover !disabled:
        color: #ffffff

      $pressed:
        image-source: /images/ui/button-blue-down
        text-offset: 1 2

      $disabled:
        color: #c0c0c0
        opacity: 0.7
        change-cursor-image: false

    CipsoftButton
      id: btnBack
      anchors.right: btnBuyNow.left
      anchors.bottom: btnBuyNow.bottom
      margin-right: 11
      !text: tr('Back')
      size: 64 20
      text-offset: 0 1
      color: #ffffff
