    id: panelSelectItem
    visible: false

  PanelSelectDate
    id: panelSelectDate
    visible: false

  PanelSelectArgument
    id: panelSelectArgument
    visible: false

  PanelConfirmation
    id: panelConfirmation
    visible: false
  
  HorizontalSeparator
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

  Panel
    id: balanceCoins
    size: 104 20
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 0
    focusable: false
    image-source: /images/ui/button-verydarkgrey-down
    image-border: 5
    image-clip: 0 0 98 40
    font: $var-cip-font-new

    UIWidget
      id: balanceCoinsIcon
      size: 12 12
      fixed-size: true
      image-fixed-ratio: true
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      focusable: false
      phantom: true
      margin-right: 3
      margin-bottom: 3
      image-source: /images/icons/icon-tibiacointransferable

    Label
      id: balanceCoinsLabel
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      !text: tr('0')
      text-auto-resize: true
      focusable: false
      phantom: true
      margin-right: 2
      margin-bottom: 3
      font: $var-cip-font-new
      color: #c0c0c0
  
  Button
    id: exitButton
    !text: tr('Cancel')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    height: 20
    width: 64
    @onClick: modules.game_store.toggleAuctionCharacter()

  Button
    id: nextButton
    !text: tr('Next')
    anchors.bottom: parent.bottom
    anchors.right: exitButton.left
    margin-right: 6
    height: 20
    width: 64
    @onClick: modules.game_store.sendNextAuctionCharacter()

  Button
    id: previousButton
    !text: tr('Previous')
    anchors.bottom: parent.bottom
    anchors.right: nextButton.left
    margin-right: 6
    height: 20
    width: 64
    @onClick: modules.game_store.sendPreviousAuctionCharacter()
  
  Button
    id: backButton
    !text: tr('Cancel')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    height: 20
    width: 64
    visible: false
    @onClick: modules.game_store.showAuctionCharacterConfigPanel('none')

  Button
    id: OkButton
    !text: tr('Ok')
    anchors.bottom: parent.bottom
    anchors.right: backButton.left
    margin-right: 6
    height: 20
    width: 64
    visible: false
    @onClick: modules.game_store.confirmAuctionCharacterConfigOk()

  Button
    id: confirmationButton
    !text: tr('Confirm')
    anchors.bottom: parent.bottom
    anchors.right: backButton.left
    image-source: /images/ui/button-blue-up
    image-clip: 0 0 98 40
    image-border: 1
    margin-right: 6
    height: 20
    width: 64
    visible: false
    @onClick: modules.game_store.confirmAuctionCharacter()

    $pressed:
      image-source: /images/ui/button-blue-down
      image-clip: 0 0 98 40
      image-border: 1
