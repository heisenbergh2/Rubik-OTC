GiftCoinsTitle < Label
  font: $var-cip-font-new
  color: #909090

GiftCoinsLabel < Label
  font: $var-cip-font-new
  color: #c0c0c0

StoreWindow
  id: storeWindow
  size: 278 227
  padding: 3
  visible: false
  @onEscape: transferCancel()

  GiftCoinsTitle
    id: transferPointsLabel
    !text: tr('Gift Tibia Coins')
    text-align: center
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: -4
    height: 20

  GiftCoinsLabel
    id: descriptionText
    !text: tr('Please select the amount of Tibia\nCoins you like to gift and enter the\nname of the character that should\nreceive the Tibia Coins.')
    text-wrap: true
    text-auto-resize: true
    anchors.top: transferPointsLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 5

  GiftCoinsLabel
    id: recipient
    !text: tr('Recipient:')
    text-horizontal-auto-resize: true
    anchors.top: descriptionText.bottom
    anchors.left: parent.left
    margin: 7
    margin-top: 12

  TextEdit
    id: transferPointsText
    size: 150 16
    font: $var-cip-font-new
    color: #c0c0c0
    anchors.verticalCenter: recipient.verticalCenter
    anchors.right: parent.right
    margin: 7
    margin-right: 13
    text-align: left
    text-offset: -18 0

  GiftCoinsLabel
    id: transferableAmount
    !text: tr('Transferable Tibia Coins:')
    anchors.top: recipient.bottom
    anchors.left: parent.left
    size: 155 12
    margin: 7
    margin-top: 10

  GiftCoinsLabel
    id: giftable
    anchors.top: prev.top
    anchors.left: prev.right
    margin-left: 7
    text-auto-resize: true

  UIWidget
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    image-source: /images/icons/icon-tibiacointransferable
    margin-left: 4

  GiftCoinsLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 10
    margin-left: 10
    text: Amount to gift:

  GiftCoinsLabel
    id: amount
    anchors.top: prev.top
    anchors.left: prev.right
    margin-left: 7
    text-auto-resize: true

  UIWidget
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    image-source: /images/icons/icon-tibiacointransferable
    margin-left: 4

  HorizontalQtScrollBar
    id: amountBar
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    minimum: 0
    step: 25
    focusable: false
    margin-left: 10
    margin-right: 10

  HorizontalSeparator
    anchors.left: parent.left
    margin-left: 5
    anchors.right: parent.right
    margin-right: 12
    anchors.top: closeButton.top
    margin-top: -12

  CipsoftButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 12
    margin-bottom: 7
    !text: tr('Cancel')
    size: 43 20
    text-offset: 0 1
    color: #ffffff

  CipsoftButton
    id: buttonOk
    anchors.right: closeButton.left
    anchors.bottom: parent.bottom
    margin-right: 10
    margin-bottom: 7
    !text: tr('Gift')
    size: 43 20
    text-offset: 0 1
    color: #ffffff
    enabled: false

    $disabled:
      color: #c0c0c0
      opacity: 0.8
      change-cursor-image: false

    $hover !disabled:
      color: #ffffff
