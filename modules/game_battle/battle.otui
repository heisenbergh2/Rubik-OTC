BattleMonks < BattleIcon
  @onSetup: |
    if g_game.getClientVersion() >= 1500 then
      self:setVisible(true)
    else
      self:setVisible(false)
    end
  
  UIWidget
    id: iconWidget
    anchors.centerIn: parent
    image-color: white
    focusable: false
    phantom: true
    image-source: /images/game/battle/icon-battlelist-monk

