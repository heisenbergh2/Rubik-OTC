  UIWidget
    id: ListBase
    size: 413 358
    anchors.top: LateralBase.top
    anchors.left: LateralBase.right
    image-source: /images/ui/1pixel-down-frame
    image-border: 10
    margin-left: 6
    padding: 1
    UIScrollArea
      id: AuctionList
      vertical-scrollbar: AuctionListScrollbar
      anchors.fill: parent
      margin-right: 13
      UIWidget
        id: auctionListGrid
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-left: 4
        margin-top: 4
        margin-bottom: 1
        layout:
          type: grid
          cell-size: 391 56
          cell-spacing: 5
          flow: true
          fit-children: true
    VerticalQtScrollBar
      id: AuctionListScrollbar
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      step: 20
      pixel-scroll: true

    Label
      id: NoResult
      !text: tr('No result.')
      font: $var-cip-font-new
      color: #C0C0C0
      text-auto-resize: true
      anchors.centerIn: parent
      visible: false
