HouseActionButton < Button
  text-offset: 0 0

  $pressed:
    text-offset: 1 1

UIWidget
  id: Cat5
  anchors.fill: parent
  visible: false
  UIWidget
    id: TopBase
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    image-source: /images/ui/2pixel-up-frame-borderimage
    image-border: 5
    height: 52
    margin-top: 10

    QtComboBox
      id: StatesOption
      size: 214 20
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 7
      font: $var-cip-font-new
      text-align: center
      text-offset: -11 1
      mouse-scroll: false

    QtComboBox
      id: CityOption
      size: 215 20
      anchors.right: StatesOption.left
      anchors.top: StatesOption.top
      margin-right: 6
      font: $var-cip-font-new
      text-align: center
      text-offset: -11 1
      mouse-scroll: false

    QtComboBox
      id: SortOption
      size: 215 20
      anchors.left: StatesOption.right
      anchors.top: StatesOption.top
      margin-left: 6
      font: $var-cip-font-new
      text-align: center
      text-offset: -11 1
      mouse-scroll: false

    RoundedCheckBox
      id: GuildhallsCheck
      anchors.bottom: parent.bottom
      anchors.left: parent.horizontalCenter
      margin-bottom: 7
      margin-left: 27
      text-offset: 15 0
      !text: tr('Guildhalls')
      font: $var-cip-font-new
      color: #C0C0C0
      text-auto-resize: true
      @onClick: modules.game_cyclopedia.Cyclopedia.houseFilter(self)

    RoundedCheckBox
      id: HousesCheck
      anchors.bottom: GuildhallsCheck.bottom
      anchors.right: GuildhallsCheck.left
      margin-right: 6
      text-offset: 15 0
      !text: tr('Houses and Flats')
      font: $var-cip-font-new
      color: #C0C0C0
      text-auto-resize: true
      @onClick: modules.game_cyclopedia.Cyclopedia.houseFilter(self)

  UIWidget
    id: LateralBase
    size: 250 358
    anchors.top: TopBase.bottom
    anchors.left: parent.left
    image-source: /images/ui/2pixel-up-frame-borderimage
    image-border: 5
    margin-top: 6
    margin-bottom: 8

    UIWidget
      id: MapBorder
      anchors.top: parent.top
      anchors.right: parent.right
      margin-right: 7
      margin-top: 58
      size: 43 43

      UIWidget
        id: ambients
        anchors.centerIn: parent
        size: 31 31

        UIWidget
          id: main
          image-source: /images/automap/timedisplay_scroll
          anchors.left: parent.left
          anchors.top: parent.top
          image-clip: 100 0 24 31
          size: 24 31

        UIWidget
          id: secondary
          image-source: /images/automap/timedisplay_scroll
          anchors.left: main.right
          anchors.top: parent.top
          image-clip: 0 0 7 31
          size: 7 31

        Button
          image-source: /images/automap/automap_phantom
          image-border: 0
          padding: 0
          anchors.fill: parent
          @onClick: modules.game_cyclopedia.Cyclopedia.houseResetPreview()
          $pressed:
            image-source: /images/automap/automap_phantom
          $hover !pressed:
            image-source: /images/automap/automap_phantom

      UIWidget
        id: rose
        anchors.fill: parent
        image-source: /images/automap/automap_rose
        image-clip: 0 0 43 43
        phantom: true

      UIWidget
        id: timedisplayGlass
        image-source: /images/automap/timedisplay-glass
        anchors.centerIn: parent
        size: 43 43
        phantom: true

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 14 0 15 8
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 14
        size: 15 8
        @onClick: modules.game_cyclopedia.Cyclopedia.houseOnClickRoseButton('north')
        $pressed !disabled:
          image-clip: 57 0 15 8

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 28 0 15 15
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 28
        size: 15 15
        @onClick: modules.game_cyclopedia.Cyclopedia.houseOnClickRoseButton('north-east')
        $pressed !disabled:
          image-clip: 114 0 15 15

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 35 14 8 15
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 35
        margin-top: 14
        size: 8 15
        @onClick: modules.game_cyclopedia.Cyclopedia.houseOnClickRoseButton('east')
        $pressed !disabled:
          image-clip: 164 14 8 15

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 28 28 15 15
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 28
        margin-top: 28
        size: 15 15
        @onClick: modules.game_cyclopedia.Cyclopedia.houseOnClickRoseButton('south-east')
        $pressed !disabled:
          image-clip: 200 28 15 15

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 14 35 15 8
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 14
        margin-top: 35
        size: 15 8
        @onClick: modules.game_cyclopedia.Cyclopedia.houseOnClickRoseButton('south')
        $pressed !disabled:
          image-clip: 229 35 15 8

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 0 28 15 15
        anchors.left: parent.left
        anchors.top: parent.top
        margin-top: 28
        size: 15 15
        @onClick: modules.game_cyclopedia.Cyclopedia.houseOnClickRoseButton('south-west')
        $pressed !disabled:
          image-clip: 258 28 15 15

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 0 14 8 15
        anchors.left: parent.left
        anchors.top: parent.top
        margin-top: 14
        size: 8 15
        @onClick: modules.game_cyclopedia.Cyclopedia.houseOnClickRoseButton('west')
        $pressed !disabled:
          image-clip: 301 14 8 15

      UIWidget
        image-source: /images/automap/automap_rose
        image-clip: 0 0 15 15
        anchors.left: parent.left
        anchors.top: parent.top
        size: 15 15
        @onClick: modules.game_cyclopedia.Cyclopedia.houseOnClickRoseButton('north-west')
        $pressed !disabled:
          image-clip: 344 0 15 15

    UIWidget
      id: layersPanel
      size: 20 68
      anchors.top: MapBorder.bottom
      anchors.right: parent.right
      margin-top: 2
      margin-right: 4

      UIWidget
        id: LayerIndicator
        image-source: /images/automap/automap_indicator_maplayers
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        margin-left: -1
        margin-bottom: 1
        image-clip: 98 0 14 67
        size: 14 67

      UIWidget
        id: layerLocks
        anchors.fill: LayerIndicator
        phantom: true

      UIWidget
        id: LayerLine
        image-source: /images/ui/separator_vertical
        margin-left: 3
        margin-top: 3
        margin-bottom: 4
        anchors.left: LayerIndicator.right
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        width: 2

      Button
        image-source: /images/automap/automap_phantom
        image-border: 0
        padding: 0
        anchors.left: LayerIndicator.left
        anchors.right: LayerIndicator.right
        anchors.top: LayerIndicator.top
        anchors.bottom: LayerIndicator.verticalCenter
        @onClick: modules.game_cyclopedia.Cyclopedia.houseUpLayer()
        $pressed:
          image-source: /images/automap/automap_phantom
        $hover !pressed:
          image-source: /images/automap/automap_phantom

      Button
        image-source: /images/automap/automap_phantom
        image-border: 0
        padding: 0
        anchors.left: LayerIndicator.left
        anchors.right: LayerIndicator.right
        anchors.top: LayerIndicator.verticalCenter
        anchors.bottom: LayerIndicator.bottom
        @onClick: modules.game_cyclopedia.Cyclopedia.houseDownLayer()
        $pressed:
          image-source: /images/automap/automap_phantom
        $hover !pressed:
          image-source: /images/automap/automap_phantom

      UIWidget
        id: layersMark
        anchors.left: LayerLine.right
        anchors.top: LayerIndicator.top
        image-source: /images/automap/automap_indicator_slider_left
        margin-top: 28
        margin-left: -3
        focusable: true

    UIWidget
      id: MapViewbase
      size: 188 212
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 7
      margin-left: 7
      margin-right: 5
      image-source: /images/ui/1pixel-down-frame
      image-border: 10

      UIWidget
        id: reload
        anchors.centerIn: parent
        image-source: /game_cyclopedia/images/icon-refresh
        opacity: 1.0
        visible: false
        $pressed:
          opacity: 0.5

      UIWidget
        id: noHouse
        anchors.fill: parent
        margin: 1
        background-color: black

        Label
          !text: tr('No house selected')
          font: $var-cip-font-new
          color: #C0C0C0
          text-offset: -1 0
          text-wrap: true
          text-auto-resize: true
          anchors.centerIn: parent

      UIMinimap
        id: houseMinimap
        anchors.fill: parent
        margin: 1
        draggable: true
        focusable: false
        color: black
        max-zoom: 5
        min-zoom: 1
        cross: false
        visible: false
        clipping: true

      UIWidget
        id: houseImage
        anchors.fill: parent
        margin: 1
        clipping: true
        phantom: true
        visible: false

    UIWidget
      id: mapControls
      anchors.left: MapBorder.left
      anchors.top: MapBorder.bottom
      margin-left: 0
      margin-top: 9
      size: 20 62

      Button
        id: ZoomOutButton
        image-source: /images/automap/automap_buttons
        image-clip: 0 20 20 20
        anchors.left: parent.left
        anchors.top: parent.top
        size: 20 20
        @onClick: modules.game_cyclopedia.Cyclopedia.houseSetZoom(false)
        $pressed !disabled:
          image-source: /images/automap/automap_buttons
          image-clip: 20 20 20 20

      Button
        id: ZoomInButton
        image-source: /images/automap/automap_buttons
        image-clip: 0 40 20 20
        anchors.left: ZoomOutButton.left
        anchors.top: ZoomOutButton.bottom
        margin-top: 1
        size: 20 20
        @onClick: modules.game_cyclopedia.Cyclopedia.houseSetZoom(true)
        $pressed !disabled:
          image-source: /images/automap/automap_buttons
          image-clip: 20 40 20 20

      Button
        id: MapButton
        image-source: /images/automap/automap_buttons
        image-clip: 0 0 20 20
        anchors.left: ZoomInButton.left
        anchors.top: ZoomInButton.bottom
        margin-top: 1
        size: 20 20
        @onClick: modules.game_cyclopedia.Cyclopedia.openSelectedHouseOnMap()
        $pressed !disabled:
          image-source: /images/automap/automap_buttons
          image-clip: 20 0 20 20

    Label
      id: AuctionLabel
      anchors.left: MapViewbase.left
      anchors.top: MapViewbase.bottom
      margin-top: 6
      margin-left: -1
      !text: tr('Auction')
      font: $var-cip-font-new
      color: #F7F7F7
      text-auto-resize: true

    Label
      id: AuctionText
      font: $var-cip-font-new
      color: #C0C0C0
      anchors.left: MapViewbase.left
      anchors.top: AuctionLabel.bottom
      margin-top: 3
      margin-left: -1
      !text: tr('There is no bid so far.\nBe the first to bid on this house.')
      text-auto-resize: true

    Label
      id: rentalTenantLabel
      !text: tr('Tenant:')
      font: $var-cip-font-new
      color: #909090
      text-align: right
      size: 91 15
      anchors.left: MapViewbase.left
      anchors.top: AuctionLabel.bottom
      margin-left: 8
      margin-top: 2
      visible: false

    Label
      id: rentalTenantValue
      font: $var-cip-font-new
      color: #C0C0C0
      text-offset: 0 1
      text-auto-resize: true
      anchors.left: rentalTenantLabel.right
      anchors.top: rentalTenantLabel.top
      margin-left: 5
      visible: false

    Label
      id: rentalPaidUntilLabel
      !text: tr('Paid Until:')
      font: $var-cip-font-new
      color: #909090
      text-align: right
      size: 91 15
      anchors.left: MapViewbase.left
      anchors.top: rentalTenantLabel.bottom
      margin-left: 8
      margin-top: 1
      visible: false

    Label
      id: rentalPaidUntilValue
      font: $var-cip-font-new
      color: #C0C0C0
      text-offset: 0 1
      text-auto-resize: true
      anchors.left: rentalPaidUntilLabel.right
      anchors.top: rentalPaidUntilLabel.top
      margin-left: 5
      visible: false

    Label
      id: moveOutPendingLabel
      !text: tr('Move out Pending')
      font: $var-cip-font-new
      text-offset: -1 0
      color: #F7F7F7
      text-auto-resize: true
      anchors.left: MapViewbase.left
      anchors.top: rentalPaidUntilLabel.bottom
      anchors.right: MapViewbase.right
      margin-top: 5
      visible: false

    Label
      id: moveOutDateLabel
      !text: tr('Date:')
      font: $var-cip-font-new
      color: #909090
      text-align: right
      size: 91 15
      anchors.left: MapViewbase.left
      anchors.top: moveOutPendingLabel.bottom
      margin-left: 8
      margin-top: 2
      visible: false

    Label
      id: moveOutDateValue
      font: $var-cip-font-new
      color: #C0C0C0
      text-offset: 0 1
      text-auto-resize: true
      anchors.left: moveOutDateLabel.right
      anchors.top: moveOutDateLabel.top
      margin-left: 5
      visible: false

    Label
      id: subAuctionLabel
      anchors.left: MapViewbase.left
      anchors.top: AuctionText.bottom
      margin-top: 5
      !text: tr('Pending Transfer')
      font: $var-cip-font-new
      text-offset: -1 0
      color: #F7F7F7
      text-auto-resize: true
      visible: false

    Label
      id: subAuctionText
      font: $var-cip-font-new
      color: #C0C0C0
      anchors.left: MapViewbase.left
      anchors.top: subAuctionLabel.bottom
      margin-top: 3
      text-auto-resize: true
      visible: false

    Label
      id: transferOwnerLabel
      !text: tr('New Owner:')
      font: $var-cip-font-new
      color: #909090
      text-align: right
      size: 99 15
      anchors.left: MapViewbase.left
      anchors.top: subAuctionLabel.bottom
      margin-left: 0
      margin-top: 2
      visible: false

    Label
      id: transferOwnerValue
      font: $var-cip-font-new
      color: #C0C0C0
      text-offset: 0 1
      text-auto-resize: true
      anchors.left: transferOwnerLabel.right
      anchors.top: transferOwnerLabel.top
      margin-left: 6
      visible: false

    Label
      id: transferDateLabel
      !text: tr('Date:')
      font: $var-cip-font-new
      color: #909090
      text-align: right
      size: 99 15
      anchors.left: MapViewbase.left
      anchors.top: transferOwnerLabel.bottom
      margin-left: 0
      margin-top: 1
      visible: false

    Label
      id: transferDateValue
      font: $var-cip-font-new
      color: #C0C0C0
      text-offset: 0 1
      text-auto-resize: true
      anchors.left: transferDateLabel.right
      anchors.top: transferDateLabel.top
      margin-left: 6
      visible: false

    Label
      id: auctionBidderLabel
      !text: tr('Highest Bidder:')
      font: $var-cip-font-new
      color: #909090
      text-align: right
      size: 99 15
      anchors.left: MapViewbase.left
      anchors.top: AuctionLabel.bottom
      margin-left: 0
      margin-top: 2
      visible: false

    Label
      id: auctionBidderValue
      font: $var-cip-font-new
      color: #C0C0C0
      text-offset: 0 1
      text-auto-resize: true
      anchors.left: auctionBidderLabel.right
      anchors.top: auctionBidderLabel.top
      margin-left: 6
      visible: false

    Label
      id: auctionEndTimeLabel
      !text: tr('End Time:')
      font: $var-cip-font-new
      color: #909090
      text-align: right
      size: 91 15
      anchors.left: MapViewbase.left
      anchors.top: auctionBidderLabel.bottom
      margin-left: 8
      margin-top: 1
      visible: false

    Label
      id: auctionEndTimeValue
      font: $var-cip-font-new
      color: #C0C0C0
      text-offset: 0 1
      text-auto-resize: true
      anchors.left: auctionEndTimeLabel.right
      anchors.top: auctionEndTimeLabel.top
      margin-left: 6
      visible: false

    Label
      id: highestBidLabel
      !text: tr('Highest Bid:')
      font: $var-cip-font-new
      color: #909090
      text-align: right
      size: 91 15
      anchors.left: MapViewbase.left
      anchors.top: auctionEndTimeLabel.bottom
      margin-left: 8
      margin-top: 1
      visible: false

    Label
      id: highestBid
      size: 100 15
      font: $var-cip-font-new
      text-align: right
      color: #C0C0C0
      anchors.right: parent.right
      anchors.top: highestBidLabel.top
      margin-right: 23
      visible: false

    UIWidget
      id: highestBidGold
      anchors.right: parent.right
      anchors.verticalCenter: highestBidLabel.verticalCenter
      margin-right: 7
      image-source: /images/icons/icon-goldcoin
      visible: false

    Label
      id: yourLimitLabel
      !text: tr('Your Limit:')
      font: $var-cip-font-new
      color: #909090
      text-align: right
      size: 91 15
      anchors.left: MapViewbase.left
      anchors.top: highestBid.bottom
      margin-left: 8
      margin-top: 1
      visible: false

    Label
      id: yourLimitBid
      size: 100 15
      font: $var-cip-font-new
      text-align: right
      color: #C0C0C0
      anchors.right: parent.right
      anchors.top: highestBid.bottom
      margin-right: 23
      margin-top: 1
      visible: false

    UIWidget
      id: yourLimitBidGold
      anchors.right: parent.right
      anchors.verticalCenter: yourLimitLabel.verticalCenter
      image-source: /images/icons/icon-goldcoin
      visible: false
      margin-right: 7

    Label
      id: transferLabel
      !text: tr('Price:')
      font: $var-cip-font-new
      color: #909090
      anchors.left: transferDateLabel.left
      anchors.top: transferDateLabel.bottom
      margin-left: 61
      margin-top: 2
      visible: false

    Label
      id: transferValue
      text-auto-resize: true
      font: $var-cip-font-new
      color: #C0C0C0
      anchors.left: transferLabel.right
      anchors.top: transferLabel.top
      visible: false
      margin-left: 5

    UIWidget
      id: transferGold
      anchors.left: transferValue.right
      anchors.verticalCenter: transferValue.verticalCenter
      margin-left: 7
      image-source: /images/icons/icon-goldcoin
      visible: false

    Panel
      id: icons
      height: 13
      anchors.verticalCenter: AuctionLabel.verticalCenter
      anchors.left: AuctionLabel.right
      anchors.right: parent.right
      margin-left: 5
      margin-right: 6
      layout:
        type: horizontalBox
        align-right: true
        flow: true

    UIWidget
      id: description
      //image-source: /game_cyclopedia/images/house-description
      anchors.top: icons.top
      anchors.left: icons.left
      visible: false

  UIWidget
    id: bidArea
    !text: tr('Place Your Bid')
    font: $var-cip-font-new
    text-align: top
    text-offset: 0 2
    color: #909090
    size: 413 358
    anchors.top: LateralBase.top
    anchors.left: LateralBase.right
    image-source: /images/ui/window-high
    image-border: 25
    margin-left: 6
    visible: false
    padding: 15

    Button
      id: cancel
      size: 43 20
      !text: tr('Cancel')
      font: verdana-bold-8px-antialiased
      color: #C0C0C0
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      text-offset: 0 0
      margin-right: 1
      margin-bottom: 1
      change-cursor-image: false

    Button
      id: bid
      size: 64 20
      !text: tr('Bid')
      font: verdana-bold-8px-antialiased
      color: #C0C0C0
      anchors.top: cancel.top
      anchors.right: cancel.left
      margin-right: 6
      text-offset: 0 0
      change-cursor-image: false

    Label
      !text: tr('House Information')
      font: $var-cip-font-new
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 14
      color: #F7F7F7

    Label
      !text: tr('Name:')
      font: $var-cip-font-new
      color: #909090
      text-align: right
      size: 90 15
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 1
      margin-left: 10

    Label
      id: name
      font: $var-cip-font-new
      text-offset: 0 1
      color: #C0C0C0
      text-auto-resize: true
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 6

    Label
      !text: tr('Size:')
      font: $var-cip-font-new
      color: #909090
      text-align: right
      size: 90 15
      anchors.top: name.bottom
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10

    Label
      id: size
      font: $var-cip-font-new
      text-offset: 0 1
      color: #C0C0C0
      text-auto-resize: true
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 6

    Label
      !text: tr('Max. Beds:')
      font: $var-cip-font-new
      color: #909090
      text-align: right
      size: 90 15
      anchors.top: size.bottom
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10

    Label
      id: beds
      font: $var-cip-font-new
      text-offset: 0 1
      color: #C0C0C0
      text-auto-resize: true
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 6

    Label
      !text: tr('Rent:')
      font: $var-cip-font-new
      color: #909090
      text-align: right
      size: 90 15
      anchors.top: beds.bottom
      anchors.left: parent.left
      margin-top: 2
      margin-left: 10

    Label
      id: rent
      font: $var-cip-font-new
      text-offset: 0 1
      color: #C0C0C0
      text-auto-resize: true
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 6

    UIWidget
      anchors.top: prev.top
      anchors.left: prev.right
      margin-top: 3
      margin-left: 4
      image-source: /images/icons/icon-goldcoin

    Label
      !text: tr('Auction Information')
      font: $var-cip-font-new
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 8
      color: #F7F7F7

    Label
      id: hightestBidder
      !text: tr('Highest Bidder:')
      font: $var-cip-font-new
      color: #909090
      text-align: right
      size: 100 15
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 1
      visible: false

    Label
      id: hightestBidder_value
      font: $var-cip-font-new
      text-offset: 0 1
      color: #C0C0C0
      text-auto-resize: true
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 6
      visible: false

    Label
      id: endTime
      !text: tr('End Time:')
      font: $var-cip-font-new
      color: #909090
