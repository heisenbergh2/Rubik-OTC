UIWidget
  anchors.fill: parent
  visible: false

  // Displayed Buttons Panel
  OnePixelDownFrame
    id: displayedButtonsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 1
    margin-left : 1
    margin-right : 1
    height: 250
 
    Label
      id: displayedButtonsLabel
      !text: tr('Displayed Shortcuts')
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 1 
      color: #909090
      font: $var-cip-font-new

    TextList
      id: displayedButtonsList
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: displayedButtonsLabel.bottom
      anchors.bottom: parent.bottom
      margin-left: 1
      margin-right: 26
      margin-top: 5
      margin-bottom: 1
      focusable: true 
      vertical-scrollbar: displayedButtonsScrollBar
      image-source: /images/ui/1pixel-down-frame
      image-border: 3
      border-width: 0
      background-color: #404040

    VerticalQtScrollBar
      id: displayedButtonsScrollBar
      anchors.top: displayedButtonsList.top
      anchors.bottom: displayedButtonsList.bottom
      anchors.right: displayedButtonsList.right
      step: 16
      pixels-scroll: true
      margin-top: 1
      margin-right: 1
      margin-bottom: 1

    UIButton
      id: moveToAvailableBtn
      anchors.top: displayedButtonsList.top
      anchors.right: parent.right
      margin-right: 1
      image-source: /images/ui/button-clear-20x20-up
      image-clip: 0 0 20 20
      width: 20
      @onClick: modules.client_options.moveToAvailable()
      $pressed:
        image-source: /images/ui/button-clear-20x20-down
      $disabled:
        image-source: /images/options/buttons_disabled_shortcuts
        image-clip: 0 0 20 20

    UIButton
      id: moveUpBtn
      anchors.top: moveToAvailableBtn.bottom
      anchors.right: parent.right
      margin-right: 1
      margin-top: 6
      image-source: /images/ui/buttons/automap-button-moveup-up
      image-clip: 0 0 20 20
      width: 20
      @onClick: modules.client_options.moveButtonUp()
      $pressed:
        image-source: /images/ui/buttons/automap-button-moveup-down
      $disabled:
        image-source: /images/options/buttons_disabled_shortcuts
        image-clip: 20 0 20 20

    UIButton
      id: moveDownBtn
      anchors.top: moveUpBtn.bottom
      anchors.right: parent.right
      margin-right: 1
      margin-top: 6
      image-source: /images/ui/buttons/automap-button-movedown-up
      image-clip: 0 0 20 20
      width: 20
      @onClick: modules.client_options.moveButtonDown()
      $pressed:
        image-source: /images/ui/buttons/automap-button-movedown-down
      $disabled:
        image-source: /images/options/buttons_disabled_shortcuts
        image-clip: 40 0 20 20

  // Available Buttons Panel
  OnePixelDownFrame
    id: availableButtonsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: displayedButtonsPanel.bottom
    anchors.bottom: parent.bottom
    margin-top: 6
    margin-left: 1
    margin-right: 1
    margin-bottom: 102

    Label
      id: availableButtonsLabel
      !text: tr('Available Shortcuts ')
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 1
      color: #909090
      font: $var-cip-font-new

    TextList
      id: availableButtonsList
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: availableButtonsLabel.bottom
      anchors.bottom: parent.bottom
      margin-left: 1 
      margin-right: 26
      margin-top: 5
      margin-bottom: 1
      padding: 1
      focusable: true
      vertical-scrollbar: availableButtonsScrollBar
      image-source: /images/ui/1pixel-down-frame
      image-border: 3
      border-width: 0
      background-color: #404040

    VerticalQtScrollBar
      id: availableButtonsScrollBar
      anchors.top: availableButtonsList.top
      anchors.bottom: availableButtonsList.bottom
      anchors.right: availableButtonsList.right
      step: 16
      pixels-scroll: true
      margin-top: 1
      margin-right: 1
      margin-bottom: 1

    UIButton
      id: moveToDisplayedBtn
      anchors.top: availableButtonsList.top
      anchors.right: parent.right
      margin-right: 1
      image-source: /images/options/button_manage_shortcuts
      image-clip: 0 0 20 20
      width: 20
      @onClick: modules.client_options.moveToDisplayed()
      $pressed:
        image-clip: 20 0 20 20
      $disabled:
        image-source: /images/options/buttons_disabled_shortcuts
        image-clip: 60 0 20 20

  QtButton
    id: resetShortcutsBtn
    size: 45 21
    text-offset: 0 1
    color: #ffffff
    !text: tr('Reset')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.client_options.resetShortcuts()