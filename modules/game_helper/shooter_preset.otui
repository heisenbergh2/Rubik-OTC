NewMainWindow
  id: window
  anchors.horizontalCenter: parent.horizontalCenter
  !text: tr('Add shooter preset')
  font: $var-cip-font-new
  color: #c0c0c0
  size: 280 110
  @onClose:
  @onEscape: self:hide()

  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 8 8 8 8

    Label
      id: text
      anchors.top: parent.top
      anchors.left: parent.left
      font: $var-cip-font-new
      color: #c0c0c0
      text-auto-resize: true
      !text: tr('Enter a name for the new preset:')
    UIWidget
      id: warning
      size: 12 12
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 8
      image-source: /images/icons/show_gui_help_red
      visible: false
      !tooltip: tr('')

    TextEdit
      id: target
      size: 200 16
      focusable: true
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      max-length: 7
      margin-top: 6

    HorizontalSeparator
      id: separator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 7

    Button
      id: cancelButton
      size: 43 20
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Cancel')

    Button
      id: okButton
      size: 43 20
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      margin-right: 8
      !text: tr('Ok')
 
 