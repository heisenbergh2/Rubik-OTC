            image-source: /images/game/tutorial/buttons/button-select-druid

      UIWidget
        id: vocationPaladin
        size: 181 361
        image-source: /images/ui/1pixel-down-frame
        image-border: 5
        anchors.top: parent.top
        anchors.left: vocationDruid.right
        margin-left: 6

        UIWidget
          id: vocationPaladinBackground
          anchors.fill: parent
          margin: 1
          image-smooth: true
          image-fixed-ratio: true
          image-source: /images/game/tutorial/backdrop_paladin

        VocationInfoSlideContainer
          id: vocationPaladinHover

          VocationInfoPanel
