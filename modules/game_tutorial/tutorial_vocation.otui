          anchors.top: parent.top
          anchors.right: parent.right
          margin-top: 4
          margin-right: 1
          image-source: /images/game/tutorial/banner_vocation_druid
          image-smooth: true
          image-fixed-ratio: true

        VocationButtonRow
          id: vocationDruidConfirmBorder
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          margin-left: 31
          margin-bottom: 9
