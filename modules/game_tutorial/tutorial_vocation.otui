        image-source: /images/ui/1pixel-down-frame
        image-border: 5
        anchors.top: parent.top
        anchors.left: vocationPaladin.right
        margin-left: 6

        UIWidget
          id: vocationMonkBackground
          anchors.fill: parent
          margin: 1
          image-smooth: true
          image-fixed-ratio: true
          image-source: /images/game/tutorial/backdrop_monk

        VocationInfoSlideContainer
