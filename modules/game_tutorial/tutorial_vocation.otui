        UIWidget
          id: vocationSorcererBanner
          size: 168 51
          anchors.top: parent.top
          anchors.right: parent.right
          margin-top: 1
          margin-right: 1
          image-source: /images/game/tutorial/banner_vocation_sorcerer
          image-smooth: true
          image-fixed-ratio: true

        VocationButtonRow
          id: vocationSorcererConfirmBorder
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          margin-left: 31
          margin-bottom: 9
          visible: false

          VocationActionButton
            id: buttonConfirmSorcerer
            image-source: /images/game/tutorial/buttons/button-confirm

        VocationButtonRow
          id: vocationSorcererSelectBorder
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          margin-left: 31
          margin-bottom: 45

          VocationSelectButton
            id: buttonSelectSorcerer
            image-source: /images/game/tutorial/buttons/button-select-sorcerer

      UIWidget
        id: vocationDruid
        size: 181 361
        image-source: /images/ui/1pixel-down-frame
        image-border: 5
        anchors.top: parent.top
        anchors.left: vocationSorcerer.right
        margin-left: 6

        UIWidget
          id: vocationDruidBackground
          anchors.fill: parent
          margin: 1
          image-smooth: true
          image-fixed-ratio: true
          image-source: /images/game/tutorial/backdrop_druid

        VocationInfoSlideContainer
          id: vocationDruidHover

          VocationInfoPanel
