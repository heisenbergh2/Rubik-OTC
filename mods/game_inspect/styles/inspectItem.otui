Slot < UIWidget
  size: 66 66
  image-source: /images/game/imbuing/slot-selected
  image-clip: 0 0 66 66
  image-fixed-ratio: true
  phantom: true
  focusable: false

  UIWidget
    id: resource
    size: 64 64
    anchors.left: parent.left
    margin-left: 1
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/game/imbuing/imbuement-icons
    image-clip: 0 0 64 64
    phantom: true

InspectLabel < Panel
  id: label
  size: 270 21
  visible: false

  Label
    id: label
    size: 151 21
    font: $var-cip-font
    color: #cdcdcd
    text-align: right
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: next.left
    text-offset: 0 5

  UIWidget
    id: separator
    size: 9 21
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 150

  Label
    id: content
    size: 270 21
    font: $var-cip-font
    color: #cdcdcd
    text-wrap: true
    text-align: left
    text-auto-resize: true
    text-offset: -2 6
    margin-left: 2
    anchors.top: parent.top
    anchors.left: prev.right

NewMainWindow
  id: inspectItem
  !text: tr('Inspect Object')
  font: $var-cip-font-new
  color: #909090
  text-offset: 0 2
  size: 482 308
  @onEscape: modules.game_inspect.hide()

  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 12 12 12 12

    UIItem
      id: item
      size: 64 64
      fixed-item-size: false
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 1
      margin-top: 1
      priceable: false
      virtual: true
      draggable: false 

    Slot
      id: imbuiSlot2
      anchors.top: parent.top
      anchors.right: parent.right
      visible: false
    Slot
      id: imbuiSlot3
      anchors.top: prev.top
      anchors.right: prev.left
      margin-right: 6
      visible: false
    Slot
      id: imbuiSlot1
      anchors.top: prev.top
      anchors.right: prev.left
      margin-right: 6
      visible: false

    Panel
      id: itemInfo
      size: 450 150
      anchors.bottom: separator.top
      anchors.left: parent.left
      margin-bottom: 13
      image-source: /images/ui/1pixel-down-frame
      image-border: 3
      border-width: 0
      background-color: #363636

      UIScrollArea
        id: itemInfoList
        vertical-scrollbar: itemInfoScroll
        anchors.fill: parent
        padding-left: 2
        padding-top: 5
        padding-bottom: 5
        padding-right: 15
        layout:
          type: verticalBox
          spacing: 0

      VerticalQtScrollBar
        id: itemInfoScroll
        anchors.top: itemInfoList.top
        anchors.bottom: itemInfoList.bottom
        anchors.right: itemInfoList.right
        margin: 1 1 1 0
        step: 16
        pixel-scroll: true

    Label
      id: name
      width: 380
      anchors.bottom: itemInfo.top
      anchors.left: item.right
      margin-left: 6
      margin-bottom: 6
      !text: tr('You are inspecting:')
      text-wrap: true
      font: $var-cip-font-new
      color: $var-text-cip-color
      text-auto-resize: true
      text-align: leftBottom

    HorizontalSeparator
      id: separator
      anchors.bottom: next.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 11

    Button
      id: prevButton
      size: 43 20
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Close')
      text-offset: 0 0
      @onClick: modules.game_inspect.hide()

    Button
      id: proficiencyButton
      size: 64 20
      anchors.bottom: prev.bottom
      anchors.right: prev.left
      margin-right: 6
      visible: false
      !text: tr('Proficiency')
      text-offset: 0 0
      @onClick: modules.game_inspect.openProficiency()

    UIButton
      id: copyInfo
      size: 20 20
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      !tooltip: tr('Copy information')
      image-source: /images/game/destiny_wheel/change_preset_icon
      image-clip: 0 0 20 20
      $pressed:
        image-clip: 0 20 20 20
      $!pressed:
        image-clip: 0 0 20 20
      @onClick: modules.game_inspect.copyInfo()
