MarketOfferListHeader < UIWidget
  size: 784 16
  background-color: #363636
  focusable: false
  phantom: false

  UIWidget
    id: nameButton
    size: 243 16
    anchors.top: parent.top
    anchors.left: parent.left
    background-color: #363636
    !text: tr('Name')
    color: #c0c0c0
    font: $var-cip-font
    text-offset: 1 -1
    text-align: leftCenter
    opacity: 1.0
    $pressed:
      color: #dfdfdf88
      opacity: 0.8

  UIWidget
    anchors.left: prev.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    image-source: /images/ui/separator_vertical

  UIWidget
    id: amountButton
    size: 128 16
    anchors.top: parent.top
    anchors.left: prev.right
    margin-left: 2
    background-color: #363636
    !text: tr('Amount')
    font: $var-cip-font
    color: #c0c0c0
    text-align: right
    text-offset: -4  -1
    opacity: 1.0
    $pressed:
      color: #dfdfdf88
      opacity: 0.8

  UIWidget
    anchors.left: prev.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    image-source: /images/ui/separator_vertical

  UIWidget
    id: piecepriceButton
    size: 128 16
    anchors.top: parent.top
    anchors.left: prev.right
    margin-left: 2
    background-color: #363636
    !text: tr('Piece Price')
    font: $var-cip-font
    color: #c0c0c0
    text-align: right
    text-offset: -5 -1
    opacity: 1.0
    $pressed:
      color: #dfdfdf88
      opacity: 0.8

  UIWidget
    anchors.left: prev.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    image-source: /images/ui/separator_vertical

  UIWidget
    id: totalpriceButton
    size: 128 16
    anchors.top: parent.top
    anchors.left: prev.right
    margin-left: 2
    background-color: #363636
    !text: tr('Total Price')
    font: $var-cip-font
    color: #c0c0c0
    text-align: right
    text-offset: -5 -1
    opacity: 1.0
    $pressed:
      color: #dfdfdf88
      opacity: 0.8

  UIWidget
    anchors.left: prev.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    image-source: /images/ui/separator_vertical

  UIWidget
    id: endButton
    size: 149 16
    anchors.top: parent.top
    anchors.left: prev.right
    margin-left: 2
    background-color: #363636
    !text: tr('Ends At')
    font: $var-cip-font
    color: #c0c0c0
    text-offset: 1 -1
    text-align: leftCenter
    opacity: 1.0
    $pressed:
      color: #dfdfdf88
      opacity: 0.8

