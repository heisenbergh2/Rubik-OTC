MarketItemList < UIWidget
  size: 36 36
  focusable: true

  UIWidget
    id: itemSlot
    size: 34 34
    image-source: /images/ui/item
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 1
    anchors.verticalCenter: parent.verticalCenter

  UIWidget
    id: rarity
    size: 32 32
    anchors.centerIn: itemSlot
    phantom: true

  UIItem
    size: 32 32
    id: item
    virtual: true
    priceable: true
    anchors.centerIn: itemSlot
    font: verdana-11px-rounded
    show-count: false
    virtual-count: true
    focusable: true
    draggable: false

  UIWidget
    id: tier
    size: 9 8
    image-source: /images/inventory/tiers-strip
    image-clip: 0 0 9 8
    image-size: 9 8
    anchors.top: item.top
    anchors.right: item.right
    phantom: true
    focusable: false
    visible: false
    image-smooth: true

  Label
    id: amount
    size: 54 16
    anchors.bottom: item.bottom
    anchors.right: item.right
    text-align: right
    color: #bfbfbf
    font: $var-cip-font-outline
    text-auto-resize: false
    !text: tr('')
    text-offset: 0 2
    visible: false

  Label
    id: name
    size: 108 32
    !text: tr("Unknow")
    font: $var-cip-font-new 
    color: #c0c0c0
    anchors.top: parent.top
    anchors.left: itemSlot.right
    text-wrap: true
    text-align: left
    text-auto-reduce: true
    margin-left: 3
    margin-top: 3

MarketMainWindow < Panel
  id: contentPanel
  anchors.fill: parent
  margin: 12 12 12 12

  TextList
    id: category
    size: 160 137
    anchors.top: parent.top
    anchors.left: parent.left
    vertical-scrollbar: categoryScroll
    image-source: /images/ui/1pixel-down-frame
    image-border: 5
    background-color: #363636
    border-width: 0
    padding-left: 1
    padding-top: 1
    padding-bottom: 1
    text-wrap: true
    @onSetup: |
      g_keyboard.bindKeyPress('Up', function() self:focusPreviousChild(KeyboardFocusReason) self:ensureChildVisible(self:getFocusedChild()) end, self)
      g_keyboard.bindKeyPress('Down', function() self:focusNextChild(KeyboardFocusReason) self:ensureChildVisible(self:getFocusedChild()) end, self)

  VerticalQtScrollBar
    id: categoryScroll
    anchors.top: prev.top
    anchors.bottom: prev.bottom
    anchors.right: prev.right
    margin-right: 1
    margin-top: 1
    margin-bottom: 1
    step: 16
    pixels-scroll: true

  MarketFilterButton
    id: levelButton
    size: 37 20
    anchors.top: category.bottom
    anchors.left: parent.left
    margin-top: 31
    !text: tr('Level')
    text-offset: 0 0
    @onClick: modules.game_market.onSortMarketFields(self, self:isChecked())

  MarketFilterButton
    id: vocButton
    size: 37 20
    anchors.top: prev.top
    anchors.left: prev.right
    margin-left: 6
    !text: tr('Voc.')
    text-offset: 0 0
    @onClick: modules.game_market.onSortMarketFields(self, self:isChecked())

  MarketFilterButton
    id: oneButton
    size: 36 20
    anchors.top: prev.top
    anchors.left: prev.right
    margin-left: 6
    !text: tr('1H')
    text-offset: 0 0
    enabled: false
    @onClick: modules.game_market.onSortMarketFields(self, self:isChecked())

  MarketFilterButton
    id: twoButton
    size: 36 20
    anchors.top: prev.top
    anchors.left: prev.right
    margin-left: 6
    !text: tr('2H')
    text-offset: 0 0
    enabled: false
    @onClick: modules.game_market.onSortMarketFields(self, self:isChecked())

  ComboBox
    id: classFilter
    size: 77 20
    !text: tr('All')
    text-offset: -11 1
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 6
    @onOptionChange: modules.game_market.onSortMarketFields(self, self.currentIndex)

  ComboBox
    id: tierFilter
    size: 79 20
    !text: tr('Tier 0')
    text-offset: -11 1
    anchors.top: prev.top
    anchors.left: prev.right
    margin-left: 6
    @onOptionChange: modules.game_market.onSortMarketFields(self, self.currentIndex)

  CheckBox
    id: lockerOnly
    size: 12 12
    !text: tr('Show Locker only')
    font: $var-cip-font
    text-auto-resize: true
    color: #c0c0c0
    text-offset: 15 -1
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 11
    image-source: /images/ui/checkbox
    image-clip: 0 0 12 12
    change-cursor-image: false

    $hover !disabled:
      color: #c0c0c0

  Label
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 7
    !text: tr('Items:')
    text-offset: -1 0
    text-auto-resize: true
    font: $var-cip-font
    color: #c0c0c0

  TextList
    id: itemList
    size: 160 258
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 5
    image-source: /images/ui/1pixel-down-frame
    image-border: 5
    background-color: #404040
    border-width: 0
    padding-left: 1
    padding-top: 1
    padding-bottom: 1
    text-wrap: true
    step: 1
    vertical-scrollbar: itemListScroll #itemListScroll
    keep-scroll-range: true
    layout:
      type: verticalBox
      cell-size: 160 36
      flow: true
    @onSetup: |
      g_keyboard.bindKeyPress('Up', function() focusPrevItemWidget(self) end, self)
      g_keyboard.bindKeyPress('Down', function() focusNextItemWidget(self) end, self)

  VerticalQtScrollBar
    id: itemListScroll
    anchors.top: prev.top
    anchors.bottom: prev.bottom
    anchors.right: prev.right
    margin-right: 1
    margin-top: 1
    margin-bottom: 1
    step: 1

  UIWidget
    id: itemSlot
    size: 34 34
    image-source: /images/ui/item
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 7

  UIWidget
    id: rarity
    size: 32 32
    anchors.centerIn: itemSlot
    phantom: true

  UIItem
    id: selectedItem
    size: 32 32
    virtual: true
    priceable: true
    font: verdana-11px-rounded
    anchors.centerIn: itemSlot
    show-count: false
    virtual-count: true
    draggable: false

  UIWidget
    id: tier
    size: 9 8
    image-source: /images/inventory/tiers-strip
    image-clip: 0 0 9 8
    image-size: 9 8
    anchors.top: selectedItem.top
    anchors.right: selectedItem.right
    phantom: true
    focusable: false
    visible: false
    image-smooth: true

  Label
    id: amount
    size: 54 16
    anchors.bottom: selectedItem.bottom
    anchors.right: selectedItem.right
    text-align: right
    color: #bfbfbf
    font: $var-cip-font-outline
    text-auto-resize: false
    !text: tr('')
    text-offset: 0 2
    visible: false

  Label
    anchors.top: selectedItem.top
    anchors.left: selectedItem.right
    margin-top: -2
    margin-left: 6
    !text: tr('Search:')
    text-auto-resize: true
    font: $var-cip-font
    color: #c0c0c0

  TextEdit
    id: searchText
    !placeholder: tr('Type to search')
    size: 121 16
    focusable: true
    anchors.top: prev.bottom
    anchors.left: selectedItem.right
    margin-left: 7
    margin-top: 5
    @onTextChange: modules.game_market.onSearchItem(self)    

  Button
    id: clearSearchButton
    anchors.verticalCenter: prev.verticalCenter
    anchors.right: prev.right
    size: 14 14
    margin-right: 1
    image-source: /images/ui/button-erase-14x14-up
    $hover:
      image-source: /images/ui/button-erase-14x14-up
    $pressed:
      image-source: /images/ui/button-erase-14x14-down
    @onClick: modules.game_market.onClearSearch()

  Panel
    id: detailsMarket
    anchors.top: category.top
    anchors.left: prev.right
    anchors.right: parent.right
    anchors.bottom: separator.top
    margin-left: 12
    margin-top: -1
    visible: false

    Label
      anchors.top: parent.top
