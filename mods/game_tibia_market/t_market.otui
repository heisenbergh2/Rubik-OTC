        margin-top: 3
        text-auto-resize: true
        color: #c0c0c0
        font: $var-cip-font

    UIButton
      id: getCoins
      size: 64 20
      anchors.bottom: parent.bottom
      anchors.left: prev.right
      margin-left: 3
      image-source: /images/ui/getCoins
      image-clip: 0 0 64 20
      !tooltip: tr('Get Tibia Coins')
      @onClick: modules.game_store.getCoinsWebsite()
      $hover !pressed:
        image-clip: 0 0 64 20
      $pressed:
        image-clip: 0 20 64 20

    Button
      id: marketButton
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Market')
      text-offset: 0 0
      size: 75 20
      @onClick: myOffersButton(self)

    Button
      id: historyButton
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      !text: tr('Offer History')
      text-offset: 0 0
      size: 75 20
      margin-right: 6
      @onClick: myOffersButton(self)

    Button
      id: currentOffers
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      !text: tr('Current Offers')
      text-offset: 0 0
      size: 75 20
      margin-right: 6
      @onClick: myOffersButton(self)

  Panel
    id: offerHistory
    anchors.fill: parent
    margin: 12 12 12 12
    visible: false

    Label
      id: sellOffersLabel
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 7
      margin-left: 1
      !text: tr('Sell Offers (0):')
      font: $var-cip-font
      text-auto-resize: true
      color: #c0c0c0

    TextList
      id: sellOffersList
      size: 718 194
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 12
      vertical-scrollbar: sellOffersListScroll
      text-wrap: true

    VerticalQtScrollBar
      id: sellOffersListScroll
      anchors.top: prev.top
      anchors.bottom: prev.bottom
      anchors.right: prev.right
      margin-right: 1
      margin-top: 1
      margin-bottom: 1
      step: 16
      pixels-scroll: true

    Label
      id: buyOffersLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 12
      margin-left: 1
      !text: tr('Buy Offers (0):')
      text-auto-resize: true
      font: $var-cip-font
      color: #c0c0c0

    TextList
      id: buyOffersList
      size: 718 194
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 12
      vertical-scrollbar: buyOffersListScroll
      text-wrap: true

    VerticalQtScrollBar
      id: buyOffersListScroll
      anchors.top: prev.top
      anchors.bottom: prev.bottom
      anchors.right: prev.right
      margin-right: 1
      margin-top: 1
      margin-bottom: 1
      step: 16
      pixels-scroll: true

    HorizontalSeparator
      id: separator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10

    Panel
      id: moneyPanel
      size: 130 20
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      image-source: /images/ui/progress
      image-border: 7
      Panel
        image-source: /images/icons/icon-goldcoin
        anchors.right: parent.right
        anchors.top: parent.top
        margin-top: 5
        margin-right: 3
      Label
        id: gold
        !text: tr('0')
        anchors.top: parent.top
        anchors.right: prev.left
        margin-right: 5
        margin-top: 3
        text-auto-resize: true
        color: #c0c0c0
        font: $var-cip-font

    Panel
      id: coinPanel
      size: 130 20
      anchors.bottom: parent.bottom
      anchors.left: prev.right
      margin-left: 5
      image-source: /images/ui/progress
      image-border: 7
      Panel
        image-source: /images/icons/icon-tibiacointransferable
        anchors.right: parent.right
        anchors.top: parent.top
        margin-top: 5
        margin-right: 3
      Label
        id: gold
        !text: tr('0')
        anchors.top: parent.top
        anchors.right: prev.left
        margin-right: 5
        margin-top: 3
        text-auto-resize: true
        color: #c0c0c0
        font: $var-cip-font

    UIButton
      id: getCoins
      size: 64 20
      anchors.bottom: parent.bottom
      anchors.left: prev.right
      margin-left: 5
      image-source: /images/ui/getCoins
      image-clip: 0 0 64 20
      !tooltip: tr('Get Tibia Coins')
      @onClick: modules.game_store.getCoinsWebsite()
      $hover !pressed:
        image-clip: 0 0 64 20
      $pressed:
        image-clip: 0 20 64 20

    Button
      id: marketButton
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Market')
      size: 75 20

    Button
      id: historyButton
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      !text: tr('Offer History')
      size: 75 20
      margin-right: 5

    Button
      id: currentOffers
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      !text: tr('Current Offers')
      size: 75 20
      margin-right: 5

MarketWindow
  id: marketWindow
  !text: tr('Market')
  text-offset: 0 2
  size: 1000 645
  @onEscape: modules.game_market.onMarketEscape()

  MarketMainWindow
    visible: true

  MarketHistory
    id: MarketHistory
    visible: false