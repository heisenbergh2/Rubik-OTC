NewMainWindow
  id: imbuingWindow
  !text: tr('Imbuement Shrine')
  size: 740 388
  font: $var-cip-font-new
  color: #909090
  text-offset: 0 2

  @onEscape: modules.game_imbuing.Imbuement.close()
  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 12 12 12 12

    SelectItemOrScroll
      id: selectItemOrScroll
      main-window-size: 740 388
      visible: true

    ScrollImbue
      id: scrollImbue
      main-window-size: 740 655
      visible: false

    SelectImbue
      id: selectImbue
      main-window-size: 740 500
      visible: false
    
    ClearImbue
      id: clearImbue
      main-window-size: 740 500
      visible: false

    HorizontalSeparator
      id: bottomSep
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: close.top
      margin-bottom: 11
    Button
      id: close
      !text: tr('Close')
      size: 43 20
      text-offset: 0 0
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      @onClick: modules.game_imbuing.Imbuement.close()
    Panel
      id: gold
      size: 104 20
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      image-source: /images/ui/button-verydarkgrey-down
      image-border: 3
      image-clip: 0 0 98 40

      UIWidget
        id: gold
        anchors.top: parent.top
        anchors.right: parent.right
        margin-top: 6
        margin-right: 3
        image-source: /images/icons/icon-goldcoin
        tooltip: Gold Coins
      UIWidget
        id: text
        anchors.top: parent.top
        anchors.right: prev.left
        margin-top: 4
        margin-right: 2
        text: 0
        font: $var-cip-font-new
        color: #c0c0c0
        text-auto-resize: true