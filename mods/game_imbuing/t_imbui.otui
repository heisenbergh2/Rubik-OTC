  Panel
    id: selectedImbuementPanel
    height: 159
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 17
    margin-top: 11
    Label
      id: title
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      !text: tr('Selected Imbuement')
      font: $var-cip-font-new
      color: #909090
      text-auto-resize: true

    Panel
      id: selectedImbuementContent
      anchors.fill: parent
      margin: 27 12 9 12

      ScrollablePanel
        id: clearImbuementsList
        height: 70
        width: 70
        &originalwidth: 680
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 37
        layout: 
          type: grid
          cell-spacing: 6
          cell-size: 66 66
          num-columns: 9
          num-rows: 3

      Label
        id: imbuementsDetails
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        font: $var-cip-font-new
        color: #c0c0c0
        text-auto-resize: true
        margin-left: -1
        margin-bottom: -2

  Panel
    id: cleanImbuePanel
    height: 141
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    image-source: /images/ui/t2pixel-up-frame-borderimage
    image-border: 17
    margin-top: 11

    Label
      id: title
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      !text: tr('Clear Imbuement "Imbuement Name"')
      font: $var-cip-font-new
      color: #909090
      text-auto-resize: true

    Panel
      id: imbuementReqContent
      anchors.fill: parent
      margin: 27 12 10 12

      Panel
        id: time
        size: 279 20
        image-source: /images/ui/infoPanel
        image-border: 3
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 34
        margin-left: 91
        phantom: false

        ProgressBarSD
          id: timeRemaining
          size: 277 18
          anchors.fill: parent
          image-source: /images/bars/progressbar-orange-large
          margin: 1 1 1 1
          phantom: true
          percent: 1

        Label
          id: textLabel
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          text-align: center
          font: $var-cip-font-new
          color: #c0c0c0
          text-auto-resize: true
          margin-top: 3
          margin-left: -1
          phantom: true

      Label
        id: cleanImbuementsDetails
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        font: $var-cip-font-new
        color: #c0c0c0
        text-auto-resize: true
        margin-left: -1
        margin-bottom: -2

      UIButton
        id: clear
        size: 128 66
        anchors.top: parent.top
        anchors.right: parent.right
        image-source: /images/game/imbuing/button-confirm-remove
        image-clip: 0 0 128 66
        $pressed:
          image-clip: 0 66 128 66

      FlatLabel
        id: costPanel
        margin-top: 3
        anchors.left: prev.left
        anchors.right: prev.right
        anchors.top: prev.bottom
        image-source: /images/ui/infoPanel

        Label
          id: cost
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: parent.top
          margin-right: 4
          margin-top: 3
          text-offset: 0 1
          text: 200
          text-align: center
          font: $var-cip-font-new
          color: #c0c0c0
          text-auto-resize: true

        UIWidget
          size: 9 9
          anchors.top: cost.top
          anchors.left: cost.right
          margin-top: 3
          margin-left: 2
          image-source: /images/icons/icon-goldcoin

