CheckBox < UICheckBox
  size: 12 12
  text-align: left
  text-offset: 18 -1
  image-rect: 0 0 12 12
  image-source: /images/ui/checkbox
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:

  $!checked:
    image-clip: 0 0 12 12

  $checked:
    image-clip: 0 12 12 12

  $disabled:
    image-clip: 0 0 12 12
    change-cursor-image: false

  $checked disabled:
    image-clip: 0 12 12 12
    change-cursor-image: false

RoundedCheckBox < UICheckBox
  size: 16 16
  text-align: left
  text-offset: 18 1
  color: #dfdfdf
  image-color: #ffffffff
  image-rect: 0 0 12 12
  image-source: /images/ui/checkboxcircle
  change-cursor-image: true
  cursor: pointer

  $!checked:
    image-clip: 0 0 12 12

  $!checked disabled:
    change-cursor-image: false

  $checked !disabled:
    image-clip: 0 12 12 12

  $checked disabled:
    image-clip: 0 24 12 12
    change-cursor-image: false

ThickCheckBox < UICheckBox
  size: 18 18
  text-align: left
  text-offset: 18 0
  color: #dfdfdf
  image-color: #ffffffff
  image-rect: 0 0 12 12
  image-offset: 3 3
  image-source: /images/ui/checkbox-unchecked

  $hover !disabled:
    color: #ffffff

  $checked:
    image-source: /images/ui/checkbox-checked

  $hover checked:
    image-source: /images/ui/checkbox-checked

  $disabled:
    image-color: #dfdfdf88
    color: #dfdfdf88
    opacity: 0.8

ColorBox < UICheckBox
  size: 16 16
  image-color: #dfdfdfff
  image-source: /images/ui/colorbox

  $checked:
    image-clip: 16 0 16 16

  $!checked:
    image-clip: 0 0 16 16

ButtonBox < UICheckBox
  font: verdana-11px-antialised
  color: #dfdfdfff
  size: 106 23
  text-offset: 0 0
  text-align: center
  image-source: /images/ui/button
  image-color: #dfdfdf
  image-clip: 0 0 22 23
  image-border: 3

  $hover !disabled:
    image-clip: 0 23 22 23

  $checked:
    image-clip: 0 46 22 23
    color: #dfdfdf

  $disabled:
    color: #dfdfdf88
    image-color: #dfdfdf88

ButtonBoxRounded < ButtonBox
  image-source: /images/ui/button_rounded

QtCheckBox < UICheckBox
  size: 14 14
  text-align: left
  text-offset: 18 -1
  color: #dfdfdf
  image-color: #ffffffff
  image-rect: 0 0 14 14
  image-source: /images/ui/newcheckbox
  font: $var-cip-font

  $!checked:
    image-clip: 0 0 14 14

  $checked !disabled:
    image-clip: 0 13 14 14

  $checked disabled:
    image-clip: 0 26 14 14
    change-cursor-image: false

fakeCheckBox < UICheckBox
  font: cipsoftFont
  size: 106 23
  image-source: /images/ui/button
  image-clip: 0 0 22 23
  image-border: 3
  padding: 5 10 5 10
  opacity: 1.0
  color: #b9b9b9ff

  $hover !disabled:
    color: #ffffff

  $!checked:
    image-clip: 0 0 22 23

  $hover !checked:
    image-clip: 0 0 22 23

  $checked:
    image-clip: 0 46 22 23

  $hover checked:
    image-clip: 0 46 22 23

  $disabled:
    image-color: #dfdfdf88
    color: #dfdfdf88
    opacity: 0.8

CheckBoxButton < UICheckBox
  size: 106 23
  image-source: /images/ui/button-grey-up
  image-border: 3
  text-align: center
  padding: 5 10 5 10
  change-cursor-image: true
  cursor: pointer
  color: #BDBDBD
  $checked:
    image-source: /images/ui/button-grey-down
    text-offset: 1 1
  $!checked:
    text-offset: 0 0
  $disabled:
    color: #dfdfdf88
    opacity: 0.8
    change-cursor-image: false

CButtonBox < UICheckBox
  font: verdana-11px-antialised
  color: #C0C0C0
  size: 106 23
  text-offset: 0 0
  text-align: center
  image-source: /images/ui/button-grey-up
  image-border: 5

  $pressed:
    image-source: /images/ui/button-grey-down

  $checked:
    image-source: /images/ui/button-grey-down

  $disabled:
    color: #dfdfdf88

RoundCheckBox < CheckBox
  image-source: /images/ui/checkboxcircle
