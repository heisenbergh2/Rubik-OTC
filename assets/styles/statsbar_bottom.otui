// --- Compact ---

TopStatsBarCompactOnBottom < UIWidget
  StatsBarBottomWithShrink
    anchors.fill: parent

  Panel
    id: compactTopCenterRow
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 7 
    height: 14
    phantom: true
    clipping: false
    focusable: false
    layout:
      type: horizontalBox
      fit-children: true

    Panel
      id: proficiencyButtonCompactWrap
      size: 15 14
      fixed-size: true
      margin-right: 5
      phantom: true
      clipping: false
      focusable: false

      UIButton
        id: proficiencyButtonCompact
        anchors.fill: parent
        image-source: /images/game/topbar/proficiency-button-compact-unequipped
        image-clip: 0 0 15 14
        !tooltip: tr('Open Weapon Proficiency Dialog')
        tooltip-delayed: true
        @onClick: modules.game_proficiency.requestOpenWindow()
        $hover !pressed:
          image-clip: 0 0 15 14
        $pressed:
          image-clip: 0 14 15 14

      // Borda 1px: hor�rio (1,0)->direita->baixo->esquerda->fecha; 54 pixels via statsbar.lua.
      Panel
        id: proficiencyButtonCompactProgress
        size: 15 14
        anchors.fill: parent
        phantom: true
        clipping: false
        focusable: false
        visible: false

      UIWidget
        id: highlightProficiencyButtonCompact
        size: 15 14
        phantom: true
        clipping: false
        image-source: /images/animations/button-highlight-15x14
        anchors.horizontalCenter: proficiencyButtonCompact.horizontalCenter
        anchors.verticalCenter: proficiencyButtonCompact.verticalCenter
        visible: false

    Panel
      id: icons
      image-border: 3
      image-source: /images/ui/button-verydarkgrey-down
      size: 103 14
      fixed-size: true
      padding-left: 2
      layout:
        type: horizontalBox

    Panel
      id: topBarMonkComboSereneCompact
      visible: false
      margin-left: 5
      margin-bottom: -1
      height: 13
      fixed-size: false
      phantom: true
      focusable: false
      layout:
        type: horizontalBox
        fit-children: true

      UIWidget
        id: topBarMonkCompactCombo1
        size: 13 13
        fixed-size: true
        phantom: true
        margin-left: 0
        image-source: /images/game/topbar/icon-combopoint-empty

      UIWidget
        id: topBarMonkCompactCombo2
        size: 13 13
        fixed-size: true
        phantom: true
        margin-left: 2
        image-source: /images/game/topbar/icon-combopoint-empty

      UIWidget
        id: topBarMonkCompactCombo3
        size: 13 13
        fixed-size: true
        phantom: true
        margin-left: 2
        image-source: /images/game/topbar/icon-combopoint-empty

      UIWidget
        id: topBarMonkCompactCombo4
        size: 13 13
        fixed-size: true
        phantom: true
        margin-left: 2
        image-source: /images/game/topbar/icon-combopoint-empty

      UIWidget
        id: topBarMonkCompactCombo5
        size: 13 13
        fixed-size: true
        phantom: true
        margin-left: 2
        image-source: /images/game/topbar/icon-combopoint-empty

      VerticalSeparatorFlat
        id: topBarMonkCompactSeparator
        margin-left: 4
        size: 2 13

      UIWidget
        id: topBarMonkCompactSereneIcon
        size: 13 13
        fixed-size: true
        phantom: true
        margin-left: 4
        image-source: /images/game/topbar/icon-serene-off

  StatsBarUp
    id: health
    anchors.top: compactTopCenterRow.top
    anchors.left: parent.left
    anchors.right: compactTopCenterRow.left
    !statsbar-type: 'health'
    !statsbar-size: 'small'
    !statsbar-orientation: 'horizontal'
    statsbar-text: true
    margin-left: 4
    margin-right: 6
    height: 14

  StatsBarUpMana
    id: mana
    anchors.top: compactTopCenterRow.top
    anchors.left: compactTopCenterRow.right
    anchors.right: parent.right
    !statsbar-type: 'mana'
    !statsbar-size: 'small'
    !statsbar-orientation: 'horizontal'
    statsbar-text: true
    margin-right: 4
    margin-left: 6
    height: 14

  Panel
    id: skills
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: mana.bottom
    margin-top: 2
    margin-left: 2
    margin-right: 4
    height: 0