// =============================================================================
// statsbar_bottom.otui — placement BOTTOM (variantes *OnBottom)
// Depende de: 30-statsbar-common.otui
// =============================================================================

// --- Shell (fundo) ---

StatsBarBottomWithShrink < UIWidget
  clipping: true
  margin-top: 3

  UIWidget
    anchors.fill: parent
    image-source: /images/ui/2pixel_up_frame_borderimage
    image-border: 2
    image-repeated: true

// --- Linha de skills (nível + barra tiny) ---

BottomStatsSkillElement < UIWidget
  height: 20

  Label
    id: level
    !text: '99999'
    font: $var-cip-font-new
    color: #c0c0c0
    text-align: right
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 9

  UIWidget
    id: icon
    size: 9 9
    anchors.verticalCenter: level.verticalCenter
    anchors.left: level.right
    margin-left: 7

  // Barra ancora ao slot (irm�o). Largura do slot = bot�o store; bot�o � direita do slot = mesmo que encostar ao bot�o.
  StatsBarUpSkill
    id: bar
    anchors.verticalCenter: level.verticalCenter
    anchors.left: icon.right
    anchors.right: statsbarXpBoostSlot.left
    !statsbar-size: 'tiny'
    !statsbar-orientation: 'horizontal'
    statsbar-text: true
    margin-left: 6
    margin-right: 2
    height: 5

  // Largura 0 por omiss�o; em Lua expande s� na linha de experi�ncia com GameExperienceBonus.
  Panel
    id: statsbarXpBoostSlot
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 0
    margin-right: 0

    UIWidget
      id: statsbarXpBoostButton
      size: 76 14
      fixed-size: true
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      visible: false
      image-source: /images/ui/button-storexp
      !tooltip: tr('Purchase XP Boost')
      tooltip-delayed: true
      @onClick: modules.game_store.openPremiumBoost()
      $pressed:
        image-source: /images/ui/button-storexp-pressed

// --- Large ---

TopStatsBarLargeOnBottom < UIWidget
  StatsBarBottomWithShrink
    anchors.fill: parent

  Panel
    id: largeTopCenterRow
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 7
    height: 27
    phantom: true
    clipping: false
    focusable: false
    layout:
      type: horizontalBox
      fit-children: true

    Panel
      id: proficiencyButtonLargeWrap
      size: 27 27
      fixed-size: true
      margin-right: 5
      phantom: true
      clipping: false
      focusable: false

      UIButton
        id: proficiencyButtonLarge
        anchors.fill: parent
        image-source: /images/game/topbar/proficiency-button-large-unequipped
        image-clip: 0 0 27 27
        !tooltip: tr('Open Weapon Proficiency Dialog')
        tooltip-delayed: true
        @onClick: modules.game_proficiency.requestOpenWindow()
        $hover !pressed:
          image-clip: 0 0 27 27
        $pressed:
          image-clip: 0 27 27 27

      // Borda 2px: anel inset (origem do traco +2,+1 no painel); 92 passos, 184 segmentos em statsbar.lua.
      Panel
        id: proficiencyButtonLargeProgress
        size: 27 27
        anchors.fill: parent
        phantom: true
        clipping: false
        focusable: false
        visible: false

      UIWidget
        id: highlightProficiencyButtonLarge
        size: 23 23
        phantom: true
        clipping: false
        image-source: /images/animations/button-highlight-23x23
        anchors.horizontalCenter: proficiencyButtonLarge.horizontalCenter
        anchors.verticalCenter: proficiencyButtonLarge.verticalCenter
        visible: false

    Panel
      id: icons
      image-border: 3
      image-source: /images/ui/button-verydarkgrey-down
      size: 53 27
      padding-left: 2
      fixed-size: true
      layout:
        type: horizontalBox

    Panel
      id: topBarMonkComboSereneLarge
      visible: false
      height: 27
      margin-left: 5
      fixed-size: true
      phantom: true
      focusable: false
      layout:
        type: horizontalBox
        fit-children: true

      UIWidget
        id: topBarMonkLargeCombo1
        size: 13 13
        fixed-size: true
        phantom: true
        margin-left: 0
        image-source: /images/game/topbar/icon-combopoint-empty

      UIWidget
        id: topBarMonkLargeCombo2
        size: 13 13
        fixed-size: true
        phantom: true
        margin-left: 2
        image-source: /images/game/topbar/icon-combopoint-empty

      UIWidget
        id: topBarMonkLargeCombo3
        size: 13 13
        fixed-size: true
        phantom: true
        margin-left: 2
        image-source: /images/game/topbar/icon-combopoint-empty

      UIWidget
        id: topBarMonkLargeCombo4
        size: 13 13
        fixed-size: true
        phantom: true
        margin-left: 2
        image-source: /images/game/topbar/icon-combopoint-empty

      UIWidget
        id: topBarMonkLargeCombo5
        size: 13 13
        fixed-size: true
        phantom: true
        margin-left: 2
        image-source: /images/game/topbar/icon-combopoint-empty

      VerticalSeparatorFlat
        id: topBarMonkLargeSeparator
        margin-left: 4
        size: 2 13

      UIWidget
        id: topBarMonkLargeSereneIcon
        size: 13 13
        fixed-size: true
        phantom: true
        margin-left: 4
        image-source: /images/game/topbar/icon-serene-off

  StatsBarUp
    id: health
    anchors.top: largeTopCenterRow.top
    anchors.left: parent.left
    anchors.right: largeTopCenterRow.left
    !statsbar-type: 'health'
    !statsbar-size: 'large'
    !statsbar-orientation: 'horizontal'
    statsbar-text: true
    margin-left: 4
    margin-right: 6
    height: 27

  Panel
    id: manaStack
    anchors.top: largeTopCenterRow.top
    anchors.right: parent.right
    anchors.left: largeTopCenterRow.right
    margin-right: 4
    margin-left: 6
    height: 27
    phantom: false
    clipping: false

    StatsBarUpManaPlain
      id: mana
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      !statsbar-type: 'mana'
      !statsbar-size: 'large'
      !statsbar-orientation: 'horizontal'
      statsbar-text: true
      height: 13

    StatsBarUpManaShieldBar
      id: manashield
      anchors.top: mana.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      height: 13
      !statsbar-type: 'manashield'
      !statsbar-size: 'small'
      !statsbar-orientation: 'horizontal'
      statsbar-text: true

  Panel
    id: skills
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: manaStack.bottom
    margin-top: 2
    margin-right: 4
    margin-left: -8
    height: 0

// --- Parallel ---

TopStatsBarParallelOnBottom < UIWidget
  StatsBarBottomWithShrink
    anchors.fill: parent

  StatsBarUp
    id: health
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    !statsbar-type: 'health'
    !statsbar-size: 'small'
    !statsbar-orientation: 'horizontal'
    statsbar-text: true
    margin-left: 4
    margin-right: 4
    margin-top: 7
    height: 14

  StatsBarUpManaLtr
    id: mana
    anchors.top: health.bottom
    anchors.left: health.left
    anchors.right: health.right
    !statsbar-type: 'mana'
    !statsbar-size: 'small'
    !statsbar-orientation: 'horizontal'
    statsbar-text: true
    margin-top: 3
    height: 14

  Panel
    id: skills
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: mana.bottom
    margin-right: 4
    margin-top: 2
    margin-left: -8
    height: 0

  Panel
    id: topBarProficiencyRow
    anchors.top: skills.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: -5
    height: 15
    phantom: true
    focusable: false

    Panel
      id: topBarProficiencyRowInner
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      height: 15
      phantom: true
      layout:
        type: horizontalBox
        fit-children: true

      Panel
        id: proficiencyButtonColumn
        size: 13 13
        fixed-size: true
        margin-right: 2
        phantom: true
        clipping: false

        UIButton
          id: proficiencyButton
          size: 13 13
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.verticalCenter: parent.verticalCenter
          image-source: /images/game/topbar/proficiency-button-default
          image-clip: 0 0 13 13
          !tooltip: tr('Open Weapon Proficiency Dialog')
          tooltip-delayed: true
          @onClick: modules.game_proficiency.requestOpenWindow()
          $hover !pressed:
            image-clip: 0 0 13 13
          $pressed:
            image-clip: 0 13 13 13

        UIWidget
          id: highlightProficiencyButton
          size: 15 15
          phantom: true
          clipping: false
          image-source: /images/animations/button-highlight-15x15
          anchors.horizontalCenter: proficiencyButton.horizontalCenter
          anchors.verticalCenter: proficiencyButton.verticalCenter
          visible: false

      Panel
        id: proficiencyPanel
        visible: false
        size: 106 13
        fixed-size: true
        margin-right: 4

        UIWidget
          id: proficiencyBg
          size: 100 13
          anchors.top: parent.top
          anchors.left: parent.left
          image-source: /images/game/topbar/proficiency-bg
          !tooltip: tr('Proficiency Progress: 0 / 1750')
          tooltip-delayed: true

          ProgressBarSD
            id: starProgress
            anchors.fill: parent
            image-source: /images/bars/progressbar-teal-11px
            margin: 1 1 1 1
            percent: 0

          Label
            id: proficiencyLabel
            margin-right: 1
            anchors.fill: parent
            text-align: center
            text-auto-resize: true
            font: $var-cip-font
            color: #f4f4f4
            text: 0%
            phantom: true

        UIWidget
          id: proficiencyIcon
          anchors.top: parent.top
          anchors.right: prev.right
          size: 9 11
          margin-top: 1
          margin-right: -4
          phantom: true
          on: false
          image-source: /images/game/topbar/icon-proficiencytree-off
          $on:
            image-source: /images/game/topbar/icon-proficiencytree-on

      Panel
        id: icons
        image-border: 3
        image-source: /images/ui/button-verydarkgrey-down
        size: 106 13
        fixed-size: true
        padding-left: 2
        layout:
          type: horizontalBox

      Panel
        id: topBarMonkComboSerene
        visible: false
        height: 13
        margin-right: 9
        fixed-size: true
        phantom: true
        focusable: false
        layout:
          type: horizontalBox
          fit-children: true

        UIWidget
          id: topBarMonkCombo1
          size: 13 13
          fixed-size: true
          phantom: true
          margin-left: 5
          image-source: /images/game/topbar/icon-combopoint-empty

        UIWidget
          id: topBarMonkCombo2
          size: 13 13
          fixed-size: true
          phantom: true
          margin-left: 2
          image-source: /images/game/topbar/icon-combopoint-empty

        UIWidget
          id: topBarMonkCombo3
          size: 13 13
          fixed-size: true
          phantom: true
          margin-left: 2
          image-source: /images/game/topbar/icon-combopoint-empty

        UIWidget
          id: topBarMonkCombo4
          size: 13 13
          fixed-size: true
          phantom: true
          margin-left: 2
          image-source: /images/game/topbar/icon-combopoint-empty

        UIWidget
          id: topBarMonkCombo5
          size: 13 13
          fixed-size: true
          phantom: true
          margin-left: 2
          image-source: /images/game/topbar/icon-combopoint-empty

        VerticalSeparatorFlat
          id: topBarMonkSeparator
          margin-left: 4
          size: 2 13

        UIWidget
          id: topBarMonkSereneIcon
          size: 13 13
          fixed-size: true
          phantom: true
          margin-left: 4
          image-source: /images/game/topbar/icon-serene-off

  UIWidget
    id: topBarDefaultBottomGap
    anchors.top: topBarProficiencyRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 0
    phantom: true
    focusable: false

// --- Default ---

TopStatsBarDefaultOnBottom < UIWidget
  StatsBarBottomWithShrink
    anchors.fill: parent

