// Faixa s� de progresso de mana shield (sem filhos com ids da mana ? evita texto duplicado).
StatsBarUpManaShieldOverlay < UIStatsBar
  clipping: true
  phantom: true
  focusable: false

  UIWidget
    id: bar
    width: 1
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin: 0 1
    image-repeated: true

  StatsHorizontalBarGrade
    id: horizontalGrade
    anchors.fill: parent
    visible: false

StatsBarUpSkill < UIStatsBar
  clipping: false
  StatsBarLightBackground
    anchors.fill: parent
    phantom: true

  UIWidget
    id: bar
    width: 1
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin: 1
    image-repeated: true

  StatsHorizontalBarGrade
    id: horizontalGrade
    anchors.fill: parent
