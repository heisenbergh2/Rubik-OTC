Item < UIItem
  size: 34 34
  padding: 1
  image-source: /images/ui/item
  font: verdana-11px-rounded
  border-color: white
  color: white

  $disabled:
    color: #646464

  UIWidget
    id: quickloot
    visible: false
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    image-source: /game_quickloot/images/icon-loot-container
    margin-bottom: 1
    margin-right: 1
    image-size: 7 9
    phantom: false
    focusable: false

  Label
    id: duration
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    phantom: true
    margin-bottom: -2
    font: "verdana-11px-rounded"
    color: #bfbfbf

  Label
    id: charges
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    phantom: true
    text-auto-resize: true
    margin-bottom: -2
    font: "verdana-11px-rounded"
    color: #bfbfbf

  Label
    id: charges2
    anchors.bottom: parent.bottom
    margin-bottom: -3
    anchors.right: parent.right
    phantom: true
    text-auto-resize: true
    font: "verdana-11px-rounded"
    visible: false

  UIWidget
    id: tier
    size: 9 8
    image-source: /images/inventory/tiers-strip
    image-clip: 0 0 9 8
    image-size: 9 8
    anchors.top: parent.top
    anchors.right: parent.right
    phantom: true
    focusable: false
    visible: false
    image-smooth: true

  UIWidget
    id: bigtier
    size: 19 16
    image-source: /images/inventory/tiers-strip-big
    image-clip: 0 0 10 9
    image-size: 18 16
    anchors.top: parent.top
    anchors.right: parent.right
    phantom: true
    focusable: false
    visible: false
    image-smooth: true

ContainerItemSlot < UIWidget
  size: 34 34
  focusable: false

  UIWidget
    id: itemSlot
    size: 34 34
    image-source: /images/ui/item
    anchors.fill: parent
    phantom: true
    focusable: false

  UIWidget
    id: rarity
    size: 32 32
    anchors.centerIn: parent
    phantom: true
    focusable: false

  UIItem
    id: item
    size: 32 32
    anchors.centerIn: parent
    font: verdana-11px-rounded
    show-count: false
    virtual-count: true
    focusable: true
    border-color: white
    color: white

    $disabled:
      color: #646464

  UIWidget
    id: tier
    size: 9 8
    image-source: /images/inventory/tiers-strip
    image-clip: 0 0 9 8
    image-size: 9 8
    anchors.top: item.top
    anchors.right: item.right
    phantom: true
    focusable: false
    visible: false
    image-smooth: true

  Label
    id: amount
    size: 54 16
    anchors.bottom: item.bottom
    anchors.right: item.right
    text-align: right
    color: #bfbfbf
    font: $var-cip-font-outline
    text-auto-resize: false
    !text: tr('')
    text-offset: 0 2
    phantom: true
    visible: false

  UIWidget
    id: quickloot
    visible: false
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    image-source: /game_quickloot/images/icon-loot-container
    margin-bottom: 2
    margin-right: 2
    image-size: 7 9
    phantom: false
    focusable: false

  UIWidget
    id: boxed
    visible: false
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    image-source: /images/icons/icon-boxed
    margin-bottom: 2
    margin-right: 2
    image-size: 7 8
    image-smooth: false
    phantom: true
    focusable: false

  Label
    id: duration
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    phantom: true
    margin-bottom: -2
    font: verdana-11px-rounded
    color: #bfbfbf

  Label
    id: charges
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    phantom: true
    text-auto-resize: true
    margin-bottom: -2
    font: verdana-11px-rounded
    color: #bfbfbf

