MainInventoryItem < UIWidget
  image-source: /images/ui/item
  image-border: 3
  phantom: false
  size: 34 34

  UIWidget
    id: goldenBorder
    anchors.fill: parent
    image-source: /images/inventory/containerslot_goldenborder
    visible: false

  UIWidget
    id: backpack
    image-source: /images/inventory/inventory_back
    anchors.centerIn: parent
    phantom: true
    enabled: false
    size: 32 32

    $disabled:
      opacity: 0

    $!disabled:
      opacity: 1

  UIWidget
    id: boots
    image-source: /images/inventory/inventory_feet
    anchors.centerIn: parent
    phantom: true
    enabled: false
    size: 32 32

    $disabled:
      opacity: 0

    $!disabled:
      opacity: 1

  UIWidget
