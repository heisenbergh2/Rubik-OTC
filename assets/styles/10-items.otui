    padding: 1
    font: verdana-11px-rounded
    border-color: white
    color: white

    UIWidget
      id: quickloot
      visible: false
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      image-source: /game_quickloot/images/icon-loot-container
      margin-bottom: 1
      margin-right: 1
      image-size: 7 9
